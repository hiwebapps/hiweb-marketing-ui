---
import Layout from '../layouts/Layout.astro';
import { HomeAfterHero, SiteNav } from '../components/sections';
import { HeroSection } from '../components/sections/HeroSection';
---

<Layout
	title="Hiweb Marketing — Pipeline medible"
	description="Ayudamos a equipos de marketing a lograr leads y conversiones claras con mensaje, paid y web como un solo sistema."
>
	<div class="min-h-dvh bg-canvas">
		<SiteNav client:load />
		<main>
			{/* GradientWaves (ogl) — hydrate only the hero island */}
			<HeroSection client:only="react" />
			{/* Buttons with BorderGlow need a React island */}
			<HomeAfterHero client:load />
		</main>

		<footer class="border-t border-border bg-canvas">
			<div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-6 py-8">
				<p class="font-display text-sm font-semibold text-ink">Hiweb Marketing</p>
				<nav class="flex flex-wrap gap-4">
					<a href="/work" class="!text-xs font-medium text-ink-soft no-underline hover:text-ink">
						Work
					</a>
					<a href="/contact" class="!text-xs font-medium text-ink-soft no-underline hover:text-ink">
						Contact
					</a>
					<a href="/sections" class="!text-xs font-medium text-ink-soft no-underline hover:text-ink">
						Kit de secciones
					</a>
				</nav>
			</div>
		</footer>
	</div>
</Layout>
