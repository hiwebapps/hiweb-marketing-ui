---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { HeroStudioA } from '../components/sections/HeroStudioA';
import { HomeAfterHero, HomeBelowFold } from '../components/sections/HomeAfterHero';
import { IndustryGrid } from '../components/sections/IndustryGrid';
import { FinalCta } from '../components/sections/FinalCta';
import { GLOBAL_METRICS, SITE } from '../data/site';
import { faqSchema } from '../lib/schema';
import { HOME_FAQS } from '../data/site';

const industries = (await getCollection('industrias')).sort((a, b) => a.data.orden - b.data.orden);
const services = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);
const cases = await getCollection('casos');
const featured = cases.filter((entry) => entry.data.destacado);

const industryName = Object.fromEntries(industries.map((item) => [item.id, item.data.nombre]));
---

<Layout
	title="Hiweb Marketing — Partner estratégico"
	description={SITE.tagline}
	jsonLd={faqSchema([...HOME_FAQS])}
>
	<main>
		<HeroStudioA client:only="react" />
		<HomeAfterHero
			services={services.map((item) => ({
				slug: item.id,
				nombre: item.data.nombre,
				tagline: item.data.tagline,
			}))}
		/>
		<IndustryGrid
			client:visible
			tone="surface"
			industries={industries.map((item) => ({
				slug: item.id,
				nombre: item.data.nombre,
				tagline: item.data.tagline,
				puntos: item.data.porQue.map((punto) => punto.title),
			}))}
		/>
		<HomeBelowFold
			cases={featured.map((item) => ({
				client: item.data.cliente,
				industry: industryName[item.data.industria.id] ?? item.data.industria.id,
				outcome: item.data.resultadoFrase,
				title: item.data.titulo,
				summary: item.data.resumen,
				href: `/portafolio/${item.id}`,
				accent: item.data.accent,
			}))}
			metrics={[...GLOBAL_METRICS]}
		/>
		<FinalCta client:load />
	</main>
</Layout>
