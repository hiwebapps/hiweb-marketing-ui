---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import { HeroStudioA } from '../components/sections/HeroStudioA';
import { HomeAfterHero, HomeBelowFold } from '../components/sections/HomeAfterHero';
import { IndustryGrid } from '../components/sections/IndustryGrid';
import { CaseStories } from '../components/sections/CaseStories';
import { ProcessPhases } from '../components/sections/ProcessPhases';
import { FaqSection } from '../components/sections/FaqSection';
import { FinalCta } from '../components/sections/FinalCta';
import '../components/sections/TeamGrid.css';
import '../components/sections/FaqSection.css';
import '../components/sections/CaseStories.css';
import { faqSchema } from '../lib/schema';
import { formatCaseStat } from '../lib/content/format';
import { getCases, getHomeCopy, getIndustries, getServices } from '../lib/content';
import { SITE } from '../data/site';

const home = await getHomeCopy();
const industries = await getIndustries();
const services = await getServices();
const CASE_ORDER = ['pulse', 'norte-industrial', 'marina-bay', 'clinica-aurora'];
const cases = (await getCases()).sort((a, b) => {
	const left = CASE_ORDER.indexOf(a.id);
	const right = CASE_ORDER.indexOf(b.id);
	return (left === -1 ? 99 : left) - (right === -1 ? 99 : right);
});
const industryName = Object.fromEntries(industries.map((item) => [item.id, item.data.nombre]));
const faqCategories = home.faqCategories ?? [];
const faqs = faqCategories.flatMap((category) => category.items);
---

<Layout
	title={home.seo?.metaTitle ?? 'Hiweb Marketing — Partner estratégico'}
	description={home.seo?.metaDescription ?? SITE.tagline}
	ogImage={home.seo?.ogImage}
	jsonLd={faqSchema(faqs)}
>
	<main>
		<HeroStudioA
			client:load
			title={home.heroTitle}
			description={home.heroLead}
			primaryLabel={home.primaryCta?.label}
			primaryHref={home.primaryCta?.href}
			secondaryLabel={home.secondaryCta?.label}
			secondaryHref={home.secondaryCta?.href}
		/>
		<HomeAfterHero
			services={services.map((item) => ({
				slug: item.id,
				nombre: item.data.nombre,
				tagline: item.data.tagline,
			}))}
		/>
		<IndustryGrid
			client:visible
			tone="canvas"
			industries={industries.map((item) => ({
				slug: item.id,
				nombre: item.data.nombre,
				tagline: item.data.tagline,
				puntos: item.data.porQue.map((punto) => punto.title),
			}))}
		/>
		<CaseStories
			client:visible
			stories={cases.map((item) => ({
				client: item.data.cliente,
				quote: item.data.testimonio?.quote ?? item.data.resumen,
				name: item.data.testimonio?.name ?? item.data.cliente,
				role: item.data.testimonio?.role
					?? industryName[item.data.industria.id]
					?? item.data.industria.id,
				stats: item.data.metricas.slice(0, 2).map(formatCaseStat),
			}))}
		/>
		<ProcessPhases client:visible phases={home.process ?? []} tone="canvas" />
		<HomeBelowFold />
		<FaqSection client:visible categories={faqCategories} />
		<FinalCta client:load />
	</main>
</Layout>
