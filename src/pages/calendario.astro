---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import { CalendarTool } from '../components/growth/CalendarTool';
import { getCalendarPage, getSiteSettings } from '../lib/content';
import { breadcrumbSchema } from '../lib/schema';

const page = await getCalendarPage('es');
const site = await getSiteSettings();
---

<Layout
	title={page.metaTitle || `${page.title} — Hiweb Marketing`}
	description={page.metaDescription}
	canonical="/calendario"
	lang="es"
	alternates={{ es: '/calendario', en: '/en/calendario' }}
	jsonLd={breadcrumbSchema([
		{ name: 'Inicio', href: '/' },
		{ name: page.title, href: '/calendario' },
	])}
>
	<main>
		<CalendarTool client:load copy={page} site={site} />
	</main>
</Layout>
