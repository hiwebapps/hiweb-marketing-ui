---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import { Badge } from '../../components/ui/Badge';
import { InstagramGridFeed } from '../../components/sections/InstagramGridFeed';
import { InstagramPhoneSwitcher } from '../../components/sections/InstagramPhoneSwitcher';
---

<Layout title="Demo: Componentes de Feed de Instagram — Hiweb Marketing" noindex>
	<main class="bg-canvas text-ink min-h-screen">
		{/* Intro Header aligned to kit */}
		<header class="max-w-[var(--section-max)] mx-auto pt-20 pb-10 px-6 border-b border-border">
			<div class="mb-4">
				<Badge variant="lime">Laboratorio de Diseño · Hiweb</Badge>
			</div>
			<h1 class="font-display text-4xl md:text-5xl font-bold tracking-tight text-ink max-w-3xl">
				Componentes de Feed de Instagram con contenido real
			</h1>
			<p class="mt-4 text-lg text-muted max-w-2xl leading-relaxed">
				Diseñados para la página de servicio de redes sociales, industrias visuales (restaurantes, turismo, retail) y casos de éxito. Filtrables por industria y alineados a la gramática del kit.
			</p>

			<div class="flex flex-wrap gap-3 mt-8">
				<a href="#opcion-a" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-ink text-canvas font-semibold text-sm hover:bg-ink/90 transition-all no-underline">
					Opción A: Grid Inmersivo por Industrias ↓
				</a>
				<a href="#opcion-b" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-surface text-ink font-semibold text-sm border border-border hover:border-ink transition-all no-underline">
					Opción B: Teléfono Switcher Multimarca ↓
				</a>
			</div>
		</header>

		{/* Opción A */}
		<div id="opcion-a" class="scroll-mt-20">
			<InstagramGridFeed
				client:load
				eyebrow="Feed Desktop de Redes Sociales"
				title="Contenido producido para marcas reales"
				description="Explora publicaciones reales filtradas por industria (Restaurantes, Retail, Turismo, E-commerce) con métricas reales y modal interactivo."
				tone="canvas"
			/>
		</div>

		{/* Opción B */}
		<div id="opcion-b" class="scroll-mt-20">
			<InstagramPhoneSwitcher
				client:load
				eyebrow="Mockup en Vivo Multimarca"
				title="Toca cada marca para cambiar el teléfono"
				description="Filtra por industria o selecciona una marca en las historias para explorar su perfil completo, bio, highlights y publicaciones en tiempo real."
				tone="surface"
			/>
		</div>
	</main>
</Layout>
