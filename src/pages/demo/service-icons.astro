---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import {
  IconDatosReales,
  IconTransparenciaReporte,
  IconAjustesTiempo,
  IconEquipoIntegrado,
  IconEspanolIngles,
} from '../../components/icons/RepresentativeServiceIcons';
import '../../components/sections/ServiceWhy.css';

// Exact cards in the exact order as displayed on the live service page
const CARDS = [
  {
    title: 'Ajustes a tiempo.',
    description:
      'El plan se mueve cuando cambia el mercado, la plataforma o el objetivo de tu negocio. No esperamos al cierre de mes para corregir.',
    accent: '#927afe', // purple
    id: 'ajustes',
  },
  {
    title: 'Datos reales, sin adivinar.',
    description:
      'Cada decisión sale de tus resultados y de lo que está haciendo tu competencia.',
    accent: '#01e7ff', // cyan
    id: 'datos',
  },
  {
    title: 'Transparencia en cada reporte.',
    description:
      'Cada mes ves qué hicimos, qué se logró y qué sigue. Si hay inversión en publicidad, la pagas directamente a la plataforma.',
    accent: '#fe621c', // orange
    id: 'transparencia',
  },
  {
    title: 'Un equipo, no cinco proveedores.',
    description:
      'SEO, publicidad, redes sociales, sitio web y CRM trabajan hacia el mismo objetivo. Todo lo que tu marca hace en digital habla el mismo idioma.',
    accent: '#74c465', // green
    id: 'equipo',
  },
  {
    title: 'Español e inglés.',
    description:
      'Trabajamos con marcas en México, Estados Unidos y Canadá. Cada pieza se escribe para su mercado, no se traduce.',
    accent: '#01e7ff', // cyan
    id: 'bilingue',
  },
];

// Replicate the infinite loop track from ServiceWhy
const half = [...CARDS, CARDS[0]];
const loopCards = [...half, ...half];
---

<Layout title="Nuevos Iconos de Servicios — Hiweb Marketing" noindex>
  <main class="bg-white text-[#111827] min-h-screen py-12 px-6">
    <div class="max-w-6xl mx-auto">
      
      <!-- Header -->
      <div class="mb-10 pb-6 border-b border-gray-200">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gray-100 border border-gray-200 text-xs font-semibold text-gray-800 uppercase tracking-wider mb-4">
          Propuesta de Diseño · Hiweb
        </div>
        <h1 class="font-display text-3xl md:text-4xl font-bold tracking-tight text-gray-900 mb-3">
          Nuevos Iconos Representativos (Fidelidad 100% al diseño actual)
        </h1>
        <p class="text-base text-gray-600 max-w-2xl leading-relaxed">
          Diseño idéntico al componente actual: fondo blanco, gradientes radiales suaves (16%), marcas de agua sutiles (18% de saturación, pura línea stroke 1.7 sin rellenos sólidos) y el efecto de máscara de desvanecimiento (<code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded text-gray-800">mask-image: fade top & bottom</code>).
        </p>
      </div>

      <!-- 1:1 Stage with Fade View (Exact replica of user screenshot) -->
      <section class="mb-16" id="comparativa">
        <div class="mb-6">
          <h2 class="text-xl font-bold text-gray-900">1. Stage 1:1 con tu captura (Con el fade y saturación al 18%)</h2>
          <p class="text-sm text-gray-500">
            Fondo original, trazo fino stroke 1.7 sin rellenos, gradiente radial tenue y el efecto de fade superior e inferior.
          </p>
        </div>

        <div class="max-w-[640px] mx-auto p-6 md:p-8 rounded-3xl border border-gray-200 bg-white shadow-sm">
          <div class="service-why__stage" style="height: 33rem;">
            <div
              class="service-why__viewport"
              style="height: 100%; overflow: hidden; mask-image: linear-gradient(to bottom, transparent 0%, #000 18%, #000 82%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 18%, #000 82%, transparent 100%);"
            >
              <ul class="service-why__track" style="animation: none; transform: translateY(-16px);">
                {loopCards.slice(0, 6).map((card) => (
                  <li
                    class="service-why__card"
                    style={`--why-accent: ${card.accent};`}
                  >
                    <h3>{card.title}</h3>
                    <p>{card.description}</p>
                    <span class="service-why__mark" aria-hidden="true">
                      {card.id === 'datos' && <IconDatosReales />}
                      {card.id === 'transparencia' && <IconTransparenciaReporte />}
                      {card.id === 'ajustes' && <IconAjustesTiempo />}
                      {card.id === 'equipo' && <IconEquipoIntegrado />}
                      {card.id === 'bilingue' && <IconEspanolIngles />}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Live Component Full Section Preview -->
      <section class="mb-16">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-xl font-bold text-gray-900">2. Vista Completa de la Sección (Con animación de scroll)</h2>
            <p class="text-sm text-gray-500">Cómo convive con el título, descripción y métricas de la página del servicio.</p>
          </div>
          <div class="flex items-center gap-3">
            <button
              id="toggle-anim-btn"
              type="button"
              class="px-4 py-2 text-xs font-medium bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-colors shadow-sm"
            >
              Pausar / Reanudar scroll
            </button>
          </div>
        </div>

        <!-- Real component container -->
        <div class="p-8 md:p-12 rounded-3xl border border-gray-200 bg-white shadow-sm overflow-hidden">
          <div class="service-why" style="grid-template-columns: 1fr 1.15fr; max-width: 1040px; margin: 0 auto;">
            
            <!-- Left Copy -->
            <div class="service-why__copy">
              <h2 class="service-why__title" style="font-size: 2.5rem; line-height: 1.15;">
                ¿Por qué elegir a Hiweb como tu Agencia SEO en México?
              </h2>
              <p class="service-why__lead">
                Un partner que piensa en tu negocio, no solo en el servicio que contratas.
              </p>
              <a
                href="/contacto"
                class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-white bg-black rounded-full hover:bg-gray-800 transition-colors"
              >
                Agenda un diagnóstico
              </a>
              <ul class="service-why__stats">
                <li>
                  <p class="service-why__stat-value">+20</p>
                  <p class="service-why__stat-label">marcas en México y el extranjero</p>
                </li>
                <li>
                  <p class="service-why__stat-value">+6</p>
                  <p class="service-why__stat-label">años de experiencia</p>
                </li>
              </ul>
            </div>

            <!-- Right Stage with fade and 2-column track -->
            <div class="service-why__stage" style="height: 34rem;">
              <div
                class="service-why__viewport"
                style="height: 100%; overflow: hidden; mask-image: linear-gradient(to bottom, transparent 0%, #000 18%, #000 82%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 18%, #000 82%, transparent 100%);"
              >
                <ul id="animated-track" class="service-why__track">
                  {loopCards.map((card, idx) => (
                    <li
                      class="service-why__card"
                      style={`--why-accent: ${card.accent};`}
                    >
                      <h3>{card.title}</h3>
                      <p>{card.description}</p>
                      <span class="service-why__mark" aria-hidden="true">
                        {card.id === 'datos' && <IconDatosReales />}
                        {card.id === 'transparencia' && <IconTransparenciaReporte />}
                        {card.id === 'ajustes' && <IconAjustesTiempo />}
                        {card.id === 'equipo' && <IconEquipoIntegrado />}
                        {card.id === 'bilingue' && <IconEspanolIngles />}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

          </div>
        </div>
      </section>

    </div>
  </main>

  <script>
    const btn = document.getElementById('toggle-anim-btn');
    const track = document.getElementById('animated-track');
    let paused = false;

    btn?.addEventListener('click', () => {
      paused = !paused;
      if (track) {
        track.style.animationPlayState = paused ? 'paused' : 'running';
      }
      if (btn) {
        btn.textContent = paused ? 'Reanudar scroll' : 'Pausar scroll';
      }
    });
  </script>
</Layout>
