---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import {
  IconDatosReales,
  IconTransparenciaReporte,
  IconAjustesTiempo,
  IconEquipoIntegrado,
  IconEspanolIngles,
  IconVideoVertical,
  IconCodigoTecnico,
  IconDisenoIdentidad,
  IconMensajesChat,
  IconTiendaEcommerce,
  IconSeguridadEscudo,
  IconBusquedaIntencion,
  IconObjetivoConversion,
  IconComunidadUsuarios,
  IconInteligenciaArtificial,
} from '../../components/icons/RepresentativeServiceIcons';
import '../../components/sections/ServiceWhy.css';

const SHOWCASE_ICONS = [
  {
    name: 'Datos Reales (Gráfica)',
    icon: 'chart',
    accent: '#01e7ff',
    component: IconDatosReales,
    title: 'Planificación guiada por métricas.',
    description: 'Diseñamos estrategias y calendarios analizando qué formatos generan mayor tracción.',
  },
  {
    name: 'Transparencia (Reporte)',
    icon: 'report',
    accent: '#fe621c',
    component: IconTransparenciaReporte,
    title: 'Reportes periódicos claros.',
    description: 'Cada mes te presentamos un informe con el avance en métricas y próximos pasos.',
  },
  {
    name: 'Ajustes a Tiempo (Cronómetro)',
    icon: 'timer',
    accent: '#927afe',
    component: IconAjustesTiempo,
    title: 'Velocidad de carga optimizada.',
    description: 'Optimizamos recursos y código para asegurar tiempos de respuesta inmediatos.',
  },
  {
    name: 'Un Equipo (Ecosistema)',
    icon: 'network',
    accent: '#74c465',
    component: IconEquipoIntegrado,
    title: 'Estrategia coordinada de canales.',
    description: 'Conectamos las campañas con la web y los flujos de seguimiento comercial.',
  },
  {
    name: 'Bilingüe / Cross-Border (Globo)',
    icon: 'globe',
    accent: '#01e7ff',
    component: IconEspanolIngles,
    title: 'Campañas en español e inglés.',
    description: 'Gestionamos cuentas binacionales para México, EE. UU. y Canadá con redacción nativa.',
  },
  {
    name: 'Video Vertical (Reels / TikTok)',
    icon: 'video',
    accent: '#74c465',
    component: IconVideoVertical,
    title: 'Contenido en video vertical.',
    description: 'Diseñamos y editamos videos para Reels y TikTok pensados para captar atención.',
  },
  {
    name: 'Código Técnico (Desarrollo Web)',
    icon: 'code',
    accent: '#927afe',
    component: IconCodigoTecnico,
    title: 'Buenas prácticas de SEO en el código.',
    description: 'Estructuramos el HTML semántico, etiquetas y arquitectura para indexación limpia.',
  },
  {
    name: 'Diseño e Identidad (Paleta)',
    icon: 'palette',
    accent: '#fe621c',
    component: IconDisenoIdentidad,
    title: 'Sistemas visuales para entornos digitales.',
    description: 'Diseñamos logotipos, tipografías y gráficos adaptados a pantallas y redes.',
  },
  {
    name: 'Mensajes y Chat (WhatsApp)',
    icon: 'chat',
    accent: '#01e7ff',
    component: IconMensajesChat,
    title: 'Atención profesional y respuesta ágil.',
    description: 'Respondemos consultas en redes y canalizamos prospectos en tiempo y forma.',
  },
  {
    name: 'Tienda y Carrito (E-commerce)',
    icon: 'cart',
    accent: '#01e7ff',
    component: IconTiendaEcommerce,
    title: 'Experiencia de compra en móviles.',
    description: 'Diseñamos catálogos y un proceso de checkout ágil para evitar carritos abandonados.',
  },
  {
    name: 'Seguridad y Protección (Escudo)',
    icon: 'shield',
    accent: '#fe621c',
    component: IconSeguridadEscudo,
    title: 'Facturación directa y seguridad.',
    description: 'Inversión facturada directamente a tu cuenta comercial con total propiedad de datos.',
  },
  {
    name: 'Búsqueda e Intención (Lupa)',
    icon: 'search',
    accent: '#74c465',
    component: IconBusquedaIntencion,
    title: 'Control de términos de búsqueda.',
    description: 'Monitoreamos consultas y agregamos palabras clave negativas para cuidar tu inversión.',
  },
  {
    name: 'Objetivo y Conversión (Diana)',
    icon: 'target',
    accent: '#01e7ff',
    component: IconObjetivoConversion,
    title: 'Enfoque en costo de adquisición.',
    description: 'Calibramos la segmentación para conseguir prospectos y ventas al menor costo posible.',
  },
  {
    name: 'Comunidad y Usuarios',
    icon: 'users',
    accent: '#927afe',
    component: IconComunidadUsuarios,
    title: 'Acompañamiento y capacitación.',
    description: 'Capacitamos a tu equipo comercial para que aproveche las herramientas en su rutina.',
  },
  {
    name: 'Inteligencia Artificial (Chispa)',
    icon: 'spark',
    accent: '#927afe',
    component: IconInteligenciaArtificial,
    title: 'Herramientas de IA evaluadas.',
    description: 'Implementamos tecnologías de IA con utilidad comprobada en mercadotecnia y ventas.',
  },
];
---

<Layout title="Nuevos Iconos de Servicios — Hiweb Marketing" noindex>
  <main class="bg-white text-[#111827] min-h-screen py-12 px-6">
    <div class="max-w-6xl mx-auto">
      
      <!-- Header -->
      <div class="mb-10 pb-6 border-b border-gray-200">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gray-100 border border-gray-200 text-xs font-semibold text-gray-800 uppercase tracking-wider mb-4">
          Propuesta de Diseño · Hiweb
        </div>
        <h1 class="font-display text-3xl md:text-4xl font-bold tracking-tight text-gray-900 mb-3">
          Nuevos Iconos Representativos (Fidelidad 100% al diseño actual)
        </h1>
        <p class="text-base text-gray-600 max-w-2xl leading-relaxed">
          Diseño idéntico al componente actual: fondo blanco, gradientes radiales suaves (16%), marcas de agua sutiles (18% de saturación, pura línea stroke 1.7 sin rellenos sólidos) y el efecto de máscara de desvanecimiento (<code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded text-gray-800">mask-image: fade top & bottom</code>).
        </p>
      </div>

      <!-- 15 New Icons Full Grid -->
      <section class="mb-16" id="catalogo">
        <div class="mb-6">
          <h2 class="text-xl font-bold text-gray-900">1. Catálogo Completo de los 15 Iconos Congruentes</h2>
          <p class="text-sm text-gray-500">
            Cada icono corresponde de forma directa y específica a lo que dice su tarjeta (stroke 1.7, trazo sutil al 18% como marca de agua).
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {SHOWCASE_ICONS.map((card) => {
            const Icon = card.component;
            return (
              <div class="flex flex-col gap-2">
                <div class="text-xs font-semibold text-gray-700 uppercase tracking-wide flex items-center justify-between">
                  <span>{card.name}</span>
                  <span class="font-mono text-gray-400 lowercase">{card.icon}</span>
                </div>
                <div
                  class="service-why__card"
                  style={`--why-accent: ${card.accent}; min-height: 12.5rem; width: 100%;`}
                >
                  <h3 class="font-semibold text-gray-900">{card.title}</h3>
                  <p class="text-sm text-gray-600">{card.description}</p>
                  <span class="service-why__mark" aria-hidden="true">
                    <Icon />
                  </span>
                </div>
              </div>
            );
          })}
        </div>
      </section>

      <!-- Live Component Full Section Preview -->
      <section class="mb-16">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-xl font-bold text-gray-900">2. Vista en Escenario Dinámico (Scroll Continuo)</h2>
            <p class="text-sm text-gray-500">Cómo conviven los nuevos iconos en la marquesina infinita del componente ServiceWhy.</p>
          </div>
          <div class="flex items-center gap-3">
            <button
              id="toggle-anim-btn"
              type="button"
              class="px-4 py-2 text-xs font-medium bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-colors shadow-sm"
            >
              Pausar / Reanudar scroll
            </button>
          </div>
        </div>

        <!-- Real component container -->
        <div class="p-8 md:p-12 rounded-3xl border border-gray-200 bg-white shadow-sm overflow-hidden">
          <div class="service-why" style="grid-template-columns: 1fr 1.15fr; max-width: 1040px; margin: 0 auto;">
            
            <!-- Left Copy -->
            <div class="service-why__copy">
              <h2 class="service-why__title" style="font-size: 2.5rem; line-height: 1.15;">
                ¿Por qué elegir a Hiweb para tu empresa?
              </h2>
              <p class="service-why__lead">
                Un partner estratégico que piensa en tu negocio, no solo en entregables aislados.
              </p>
              <a
                href="/contacto"
                class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-white bg-black rounded-full hover:bg-gray-800 transition-colors"
              >
                Agenda un diagnóstico
              </a>
              <ul class="service-why__stats">
                <li>
                  <p class="service-why__stat-value">+20</p>
                  <p class="service-why__stat-label">marcas en México y el extranjero</p>
                </li>
                <li>
                  <p class="service-why__stat-value">+6</p>
                  <p class="service-why__stat-label">años de experiencia</p>
                </li>
              </ul>
            </div>

            <!-- Right Stage with fade and 2-column track -->
            <div class="service-why__stage" style="height: 34rem;">
              <div
                class="service-why__viewport"
                style="height: 100%; overflow: hidden; mask-image: linear-gradient(to bottom, transparent 0%, #000 18%, #000 82%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 18%, #000 82%, transparent 100%);"
              >
                <ul id="animated-track" class="service-why__track">
                  {[...SHOWCASE_ICONS.slice(0, 8), ...SHOWCASE_ICONS.slice(0, 8)].map((card) => {
                    const Icon = card.component;
                    return (
                      <li
                        class="service-why__card"
                        style={`--why-accent: ${card.accent};`}
                      >
                        <h3>{card.title}</h3>
                        <p>{card.description}</p>
                        <span class="service-why__mark" aria-hidden="true">
                          <Icon />
                        </span>
                      </li>
                    );
                  })}
                </ul>
              </div>
            </div>

          </div>
        </div>
      </section>

    </div>
  </main>

  <script>
    const btn = document.getElementById('toggle-anim-btn');
    const track = document.getElementById('animated-track');
    let paused = false;

    btn?.addEventListener('click', () => {
      paused = !paused;
      if (track) {
        track.style.animationPlayState = paused ? 'paused' : 'running';
      }
      if (btn) {
        btn.textContent = paused ? 'Reanudar scroll' : 'Pausar scroll';
      }
    });
  </script>
</Layout>
