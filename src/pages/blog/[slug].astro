---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { PageHero } from '../../components/sections/PageHero';
import { SectionBand } from '../../components/sections/primitives/SectionBand';
import { FaqSection } from '../../components/sections/FaqSection';
import { FinalCta } from '../../components/sections/FinalCta';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../lib/schema';

export async function getStaticPaths() {
	const posts = await getCollection('posts');
	return posts.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const schemas = [
	breadcrumbSchema([
		{ name: 'Inicio', href: '/' },
		{ name: 'Blog', href: '/blog' },
		{ name: entry.data.title, href: `/blog/${entry.id}` },
	]),
	articleSchema({
		title: entry.data.title,
		description: entry.data.description,
		href: `/blog/${entry.id}`,
		author: entry.data.autor,
		date: entry.data.fecha,
	}),
	...(entry.data.faqs.length ? [faqSchema(entry.data.faqs)] : []),
];
---

<Layout
	title={`${entry.data.title} — Hiweb`}
	description={entry.data.description}
	jsonLd={schemas}
>
	<main>
		<PageHero
			eyebrow={entry.data.keyword}
			title={entry.data.title}
			description={entry.data.description}
		/>
		<SectionBand>
			<article class="prose-hiweb mx-auto max-w-3xl">
				<p class="!text-sm text-muted">
					{entry.data.autor} · {entry.data.fecha.toLocaleDateString('es-MX')}
				</p>
				<div class="mt-8 space-y-4 [&_a]:underline [&_h2]:mt-10 [&_h2]:font-display [&_h2]:text-2xl [&_h3]:mt-6 [&_h3]:font-display [&_li]:!text-base [&_ol]:list-decimal [&_ol]:pl-5 [&_p]:!text-base [&_ul]:list-disc [&_ul]:pl-5">
					<Content />
				</div>
			</article>
		</SectionBand>
		{entry.data.faqs.length ? (
			<FaqSection client:visible items={entry.data.faqs} title="Preguntas del artículo" withSchema={false} />
		) : null}
		<FinalCta client:load />
	</main>
</Layout>
