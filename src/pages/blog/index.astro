---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { PageHero } from '../../components/sections/PageHero';
import { SectionBand } from '../../components/sections/primitives/SectionBand';
import { BlogIndex } from '../../components/sections/BlogIndex';
import { FinalCta } from '../../components/sections/FinalCta';
import { breadcrumbSchema } from '../../lib/schema';

const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf(),
);
const industries = (await getCollection('industrias')).sort((a, b) => a.data.orden - b.data.orden);
const services = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);
---

<Layout
	title="Blog — Hiweb Marketing"
	description="Contenido organizado por industrias y servicios. Respuestas directas, sin relleno."
	jsonLd={breadcrumbSchema([
		{ name: 'Inicio', href: '/' },
		{ name: 'Blog', href: '/blog' },
	])}
>
	<main>
		<PageHero
			eyebrow="Blog"
			title="Marketing por industria, escrito para decidir"
			description="Artículos con keyword, respuesta directa y enlaces a servicios o casos. No un magazine."
		/>
		<SectionBand>
			<BlogIndex
				client:load
				posts={posts.map((post) => ({
					id: post.id,
					title: post.data.title,
					description: post.data.description,
					keyword: post.data.keyword,
					autor: post.data.autor,
					fecha: post.data.fecha.toLocaleDateString('es-MX'),
					featured: post.data.featured,
					industria: post.data.categoriaIndustria?.id,
					servicio: post.data.categoriaServicio?.id,
				}))}
				industries={industries.map((item) => ({ slug: item.id, nombre: item.data.nombre }))}
				services={services.map((item) => ({ slug: item.id, nombre: item.data.nombre }))}
			/>
		</SectionBand>
		<FinalCta client:load title="¿Lo aplicamos a tu industria?" />
	</main>
</Layout>
