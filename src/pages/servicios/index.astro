---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import { getCases, getCatalogIndex, getHomeCopy, getIndustries, getServices } from '../../lib/content';
import { PageHero } from '../../components/sections/PageHero';
import { ServiceGrid } from '../../components/sections/ServiceGrid';
import { IndustryGrid } from '../../components/sections/IndustryGrid';
import { ProcessPhases } from '../../components/sections/ProcessPhases';
import { CasePreview } from '../../components/sections/CasePreview';
import { FinalCta } from '../../components/sections/FinalCta';
import { breadcrumbSchema } from '../../lib/schema';
import { WEBFLOW_SERVICES_INDEX } from '../../data/webflow-services';

const services = await getServices();
const page = await getCatalogIndex('servicesIndex');
const hero = {
	eyebrow: page?.eyebrow ?? WEBFLOW_SERVICES_INDEX.eyebrow,
	title: page?.title ?? WEBFLOW_SERVICES_INDEX.title,
	description: page?.description ?? WEBFLOW_SERVICES_INDEX.description,
};
const industries = await getIndustries();
const cases = await getCases();
const home = await getHomeCopy();
const industryName = Object.fromEntries(industries.map((item) => [item.id, item.data.nombre]));
---

<Layout
	title={page?.seo?.metaTitle ?? hero.title}
	description={page?.seo?.metaDescription ?? hero.description}
	noindex={page?.seo?.noindex}
	canonical={page?.seo?.canonicalPath}
	alternates={{ es: '/servicios', en: '/en/servicios' }}
	jsonLd={breadcrumbSchema([
		{ name: 'Inicio', href: '/' },
		{ name: 'Servicios', href: '/servicios' },
	])}
>
	<main>
		<PageHero
			eyebrow={hero.eyebrow}
			title={hero.title}
			description={hero.description}
			headingWidth={page?.headingWidth}
		/>
		<ServiceGrid
			services={services.map((item) => ({
				slug: item.id,
				nombre: item.data.nombre,
				tagline: item.data.tagline,
			}))}
			eyebrow={home.serviceIntro?.eyebrow ?? hero.eyebrow}
			title={home.serviceIntro?.title ?? hero.title}
			description={home.serviceIntro?.description ?? hero.description}
			headingWidth={home.serviceIntro?.headingWidth}
		/>
		<IndustryGrid
			client:visible
			industries={industries.map((item) => ({
				slug: item.id,
				nombre: item.data.nombre,
				tagline: item.data.tagline,
				puntos: item.data.porQue.map((punto) => punto.title),
			}))}
			title={page?.sectionTitle ?? 'El mismo servicio, un playbook distinto por industria'}
			headingWidth={page?.sectionHeadingWidth}
			tone="surface"
		/>
		<ProcessPhases client:visible phases={home.process ?? []} tone="canvas" />
		<CasePreview
			cases={cases.slice(0, 3).map((item) => ({
				client: item.data.cliente,
				industry: industryName[item.data.industria.id] ?? item.data.industria.id,
				title: item.data.titulo,
				summary: item.data.resumen,
				href: `/portafolio/${item.id}`,
				accent: item.data.accent,
			}))}
		/>
		<FinalCta
			client:load
			title={page?.closingTitle ?? 'Elige palanca después del diagnóstico'}
			headingWidth={page?.closingHeadingWidth}
		/>
	</main>
</Layout>
