---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { IndustryHero } from '../../components/sections/IndustryHero';
import { IndustryServices } from '../../components/sections/IndustryServices';
import { PillarGrid } from '../../components/sections/PillarGrid';
import { CaseStories } from '../../components/sections/CaseStories';
import { FaqSection } from '../../components/sections/FaqSection';
import { FinalCta } from '../../components/sections/FinalCta';
import { breadcrumbSchema, faqSchema } from '../../lib/schema';
import { industryServiceDescription } from '../../data/industryServices';
import type { BadgeVariant } from '../../components/ui';
import '../../components/sections/CaseStories.css';
import '../../components/sections/FaqSection.css';
import '../../components/sections/IndustryServices.css';

export async function getStaticPaths() {
	const industries = await getCollection('industrias');
	return industries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const services = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);
const cases = (await getCollection('casos')).filter((item) => item.data.industria.id === entry.id);
const heroImage = entry.data.heroImage ?? `/images/industries/${entry.id}.jpg`;
const industryHeroBadges: { label: string; variant: BadgeVariant }[] = [
	{ label: entry.data.nombre, variant: 'lime' },
];

const industryServices = services.map((item) => ({
	slug: item.id,
	nombre: item.data.nombre,
	description: industryServiceDescription(entry.id, item.id, entry.data.nombre),
}));

function formatCaseStat(metric: {
	valor: number;
	prefix?: string;
	suffix?: string;
	decimals?: number;
	label: string;
}) {
	const value = `${metric.prefix ?? ''}${
		metric.decimals != null ? metric.valor.toFixed(metric.decimals) : metric.valor
	}${metric.suffix ?? ''}`;
	return { value, label: metric.label };
}

const caseStories = cases.map((item) => ({
	client: item.data.cliente,
	quote: item.data.testimonio?.quote ?? item.data.resumen,
	name: item.data.testimonio?.name ?? item.data.cliente,
	role: item.data.testimonio?.role ?? entry.data.nombre,
	stats: item.data.metricas.slice(0, 2).map(formatCaseStat),
	href: `/portafolio/${item.id}`,
}));
---

<Layout
	title={`${entry.data.nombre} — Hiweb Marketing`}
	description={entry.data.heroDescription}
	jsonLd={[
		breadcrumbSchema([
			{ name: 'Inicio', href: '/' },
			{ name: 'Industrias', href: '/industrias' },
			{ name: entry.data.nombre, href: `/industrias/${entry.id}` },
		]),
		faqSchema(entry.data.faqs),
	]}
>
	<main>
		<IndustryHero
			title={entry.data.heroTitle}
			description={entry.data.heroDescription}
			image={heroImage}
			imageAlt={entry.data.heroImageAlt ?? `Imagen de ${entry.data.nombre}`}
			badges={industryHeroBadges}
			ctaLabel="Ver casos de éxito"
			ctaHref="#casos"
		/>
		<PillarGrid
			eyebrow="Por qué Hiweb"
			title={`Por qué Hiweb en ${entry.data.nombre.toLowerCase()}`}
			pillars={entry.data.porQue}
			tone="canvas"
		/>
		<IndustryServices
			industryName={entry.data.nombre}
			services={industryServices}
			title={`Nueve servicios, leídos como ${entry.data.nombre}`}
			description="Elige la palanca. El diagnóstico define el orden."
			tone="canvas"
		/>
		<CaseStories
			client:visible
			eyebrow="Casos"
			title={`Casos en ${entry.data.nombre.toLowerCase()}`}
			description={
				cases.length
					? 'Resultados de empresas consolidadas en este sector.'
					: 'Estamos documentando más casos de este sector. El diagnóstico sigue abierto.'
			}
			stories={caseStories}
		/>
		<FaqSection
			client:visible
			items={entry.data.faqs}
			title={`Preguntas de ${entry.data.nombre.toLowerCase()}`}
			withSchema={false}
		/>
		<FinalCta
			client:load
			title={`Agenda un diagnóstico para ${entry.data.nombre.toLowerCase()}`}
		/>
	</main>
</Layout>
