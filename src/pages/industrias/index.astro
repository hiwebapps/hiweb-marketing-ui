---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import { getCases, getIndustries, getIndustriesIndex } from '../../lib/content';
import { PageHero } from '../../components/sections/PageHero';
import { IndustryGrid } from '../../components/sections/IndustryGrid';
import { PillarGrid } from '../../components/sections/PillarGrid';
import { CasePreview } from '../../components/sections/CasePreview';
import { FinalCta } from '../../components/sections/FinalCta';
import { HOME_PILLARS } from '../../data/site';
import { breadcrumbSchema } from '../../lib/schema';

const industries = await getIndustries();
const page = await getIndustriesIndex('industriesIndex');
const cases = await getCases();
const pillars = (page?.pillars?.length ? page.pillars : HOME_PILLARS).map((pillar, index) => {
	const visual = HOME_PILLARS[index];
	return {
		title: pillar.title,
		description: pillar.description,
		icon: visual?.icon,
		accent: visual?.accent,
		href: visual?.href,
	};
});
const industryName = Object.fromEntries(industries.map((item) => [item.id, item.data.nombre]));
---

<Layout
	title={page?.seo?.metaTitle ?? 'Industrias — Hiweb Marketing'}
	description={page?.seo?.metaDescription ?? page?.description ?? 'Hablamos el idioma de tu sector: manufactura, salud, inmobiliarias, turismo, restaurantes y SaaS.'}
	noindex={page?.seo?.noindex}
	canonical={page?.seo?.canonicalPath}
	alternates={{ es: '/industrias', en: '/en/industrias' }}
	jsonLd={breadcrumbSchema([
		{ name: 'Inicio', href: '/' },
		{ name: 'Industrias', href: '/industrias' },
	])}
>
	<main>
		<PageHero
			eyebrow={page?.eyebrow ?? 'Industrias'}
			title={page?.title ?? 'De lista de servicios a arquitectura por industria'}
			description={page?.description ?? 'Casos, retos y palancas propias de tu sector. El catálogo existe; el playbook cambia.'}
		/>
		<IndustryGrid
			client:visible
			industries={industries.map((item) => ({
				slug: item.id,
				nombre: item.data.nombre,
				tagline: item.data.tagline,
				puntos: item.data.porQue.map((punto) => punto.title),
			}))}
		/>
		<PillarGrid
			eyebrow={page?.whyEyebrow ?? 'Por qué Hiweb'}
			title={page?.whyTitle ?? 'Un partner que ya operó en tu mesa de decisiones'}
			pillars={pillars}
			tone="surface"
		/>
		<CasePreview
			cases={cases.slice(0, 3).map((item) => ({
				client: item.data.cliente,
				industry: industryName[item.data.industria.id] ?? item.data.industria.id,
				title: item.data.titulo,
				summary: item.data.resumen,
				href: `/portafolio/${item.id}`,
				accent: item.data.accent,
			}))}
		/>
		<FinalCta client:load title={page?.closingTitle ?? 'Agenda un diagnóstico por industria'} />
	</main>
</Layout>
