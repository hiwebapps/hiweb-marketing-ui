---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import { caseStaticPaths, getCases, getIndustries } from '../../lib/content';
import { CaseTelescopeHero } from '../../components/sections/CaseTelescopeHero';
import { SectionBand } from '../../components/sections/primitives/SectionBand';
import { SectionHeader } from '../../components/sections/primitives/SectionHeader';
import { BeforeAfter } from '../../components/sections/BeforeAfter';
import { ProcessPhases } from '../../components/sections/ProcessPhases';
import { MetricsBand } from '../../components/sections/MetricsBand';
import { CaseStories } from '../../components/sections/CaseStories';
import { CaseCards } from '../../components/sections/CasesIndex';
import FinalCta from '../../components/sections/FinalCtaBand.astro';
import { InstagramPhoneSwitcher } from '../../components/sections/InstagramPhoneSwitcher';
import { SOCIAL_BRANDS, type BrandProfile } from '../../components/sections/social-feed-data';
import { breadcrumbSchema } from '../../lib/schema';
import { postCoverUrl } from '../../lib/blog';
import { formatCaseStat } from '../../lib/content/format';
import { notFound, resolveEntry } from '../../lib/content/resolve-entry';
import type { CasePageSection, CaseRecord } from '../../lib/content/types';
import '../../components/sections/CaseTelescopeHero.css';
import '../../components/sections/MetricsBand.css';
import '../../components/sections/CaseStories.css';
import '../../components/sections/BlogIndex.css';

export async function getStaticPaths() {
	return caseStaticPaths();
}

interface Props {
	entry: CaseRecord;
}

const entry = await resolveEntry<CaseRecord>(Astro.props.entry, Astro.params.slug, caseStaticPaths);
if (!entry) return notFound();
const industries = await getIndustries();
const industry = industries.find((item) => item.id === entry.data.industria.id);
const relatedServices = entry.data.servicios;
const allCases = await getCases();
const related = allCases.filter(
	(item) => item.id !== entry.id && item.data.industria.id === entry.data.industria.id,
);

const projectWords = entry.data.cliente.trim().split(/\s+/);
const projectMid = Math.max(1, Math.ceil(projectWords.length / 2));
const titleLeft = projectWords.slice(0, projectMid).join(' ');
const titleRight = projectWords.slice(projectMid).join(' ');

const matchingSocialBrand: BrandProfile | undefined = entry.data.socialBrand
	? {
			id: entry.data.socialBrand.handle || entry.id,
			name: entry.data.socialBrand.name || entry.data.cliente,
			handle: entry.data.socialBrand.handle,
			category: entry.data.socialBrand.category || '',
			industryId: entry.data.industria.id || '',
			industryName: industry?.data.nombre || '',
			avatar: entry.data.socialBrand.avatar || '',
			bio: entry.data.socialBrand.bio || '',
			linkText: entry.data.socialBrand.linkText,
			linkUrl: entry.data.socialBrand.linkUrl,
			stats: {
				posts: entry.data.socialBrand.stats?.posts || '12',
				followers: entry.data.socialBrand.stats?.followers || '1.2k',
				following: entry.data.socialBrand.stats?.following || '100',
			},
			highlights: (entry.data.socialBrand.highlights || []).map((h) => ({
				title: h.title,
				cover: h.cover || '',
			})),
			posts: (entry.data.socialBrand.posts || []).map((p) => ({
				id: p.id,
				brandId: entry.data.socialBrand?.handle || '',
				brandName: entry.data.socialBrand?.name || entry.data.cliente,
				brandHandle: entry.data.socialBrand?.handle || '',
				brandAvatar: entry.data.socialBrand?.avatar || '',
				brandCategory: entry.data.socialBrand?.category || '',
				kind: p.kind,
				cover: p.cover,
				slides: (p.slides || []).map((s) => ({ src: s.src, alt: s.alt || '' })),
				caption: p.caption || '',
				videoUrl: p.videoUrl,
				stats: {
					views: p.stats?.views,
					likes: p.stats?.likes,
					comments: p.stats?.comments,
					shares: p.stats?.shares,
				},
				outcomeTag: p.outcomeTag,
				caseSlug: entry.id,
			})),
		}
	: SOCIAL_BRANDS.find(
			(b) =>
				b.id.toLowerCase() === entry.id.toLowerCase() ||
				b.handle.toLowerCase() === entry.id.toLowerCase() ||
				entry.id.toLowerCase().includes(b.id.toLowerCase()) ||
				b.id.toLowerCase().includes(entry.id.toLowerCase()) ||
				b.name.toLowerCase().includes(entry.data.cliente.toLowerCase()) ||
				entry.data.cliente.toLowerCase().includes(b.name.toLowerCase()),
		);

const sections: CasePageSection[] = entry.data.sections?.length
	? entry.data.sections.filter((section) => !section.hidden)
	: [
			{
				_type: 'caseHero',
				anio: entry.data.anio,
				ubicacion: entry.data.ubicacion,
				imagen: entry.data.imagen,
				imagenAlt: entry.data.imagenAlt,
				imagenesProyecto: entry.data.imagenesProyecto,
			},
			{
				_type: 'caseContext',
				retoEyebrow: 'Reto',
				retoTitle: 'Contexto inicial',
				reto: entry.data.reto,
				estrategiaEyebrow: 'Estrategia',
				estrategiaTitle: 'Servicios aplicados',
				estrategia: entry.data.estrategia,
				sitioWeb: entry.data.sitioWeb,
				redSocial: entry.data.redSocial,
			},
			{
				_type: 'caseProcess',
				eyebrow: 'Ejecución',
				title: 'Cómo se hizo el trabajo',
				fases: entry.data.fases,
			},
			{
				_type: 'caseMetrics',
				eyebrow: 'Cifras',
				title: 'Antes y después',
				description: 'Baseline incluido cuando aplica. Números de negocio, no recortes de Ads Manager.',
				metricas: entry.data.metricas,
			},
			...(entry.data.testimonio
				? [
						{
							_type: 'caseTestimonial' as const,
							eyebrow: 'Testimonio',
							title: `Lo que dice ${entry.data.cliente}`,
							description: 'Voz del cliente. Sin quotes inventadas ni outcomes ornamentales.',
							quote: entry.data.testimonio.quote,
							name: entry.data.testimonio.name,
							role: entry.data.testimonio.role,
							client: entry.data.testimonio.client,
							photo: entry.data.testimonio.photo,
						},
					]
				: []),
			{
				_type: 'caseRelated',
				eyebrow: 'Casos',
				title: 'Más casos de esta industria',
				description: 'Cliente, industria y el trabajo realizado.',
			},
			{ _type: 'caseCta', title: 'Agenda un diagnóstico similar' },
		];

const heroSection = sections.find((section) => section._type === 'caseHero');
const heroImage =
	(heroSection?._type === 'caseHero' ? heroSection.imagen : undefined) ??
	entry.data.seo?.ogImage ??
	industry?.data.heroImage ??
	postCoverUrl(`caso-${entry.id}`, 1600, 1000);
const heroAlt =
	(heroSection?._type === 'caseHero' ? heroSection.imagenAlt : undefined) ||
	industry?.data.heroImageAlt ||
	`Imagen del caso ${entry.data.cliente}`;
---

<Layout
	title={entry.data.seo?.metaTitle ?? entry.data.titulo ?? entry.data.cliente}
	description={entry.data.seo?.metaDescription ?? entry.data.resumen}
	ogImage={entry.data.seo?.ogImage ?? heroImage}
	noindex={entry.data.seo?.noindex}
	canonical={entry.data.seo?.canonicalPath}
	alternates={
		entry.alternateSlug
			? { es: `/portafolio/${entry.id}`, en: `/en/success-stories/${entry.alternateSlug}` }
			: undefined
	}
	jsonLd={breadcrumbSchema([
		{ name: 'Inicio', href: '/' },
		{ name: 'Portafolio', href: '/portafolio' },
		{ name: entry.data.cliente, href: `/portafolio/${entry.id}` },
	])}
>
	<main>
		{sections.map((section) => {
			if (section._type === 'caseHero') {
				return (
					<CaseTelescopeHero
						client:load
						titleLeft={titleLeft}
						titleRight={titleRight}
						image={heroImage}
						imageAlt={heroAlt}
						floatImages={section.imagenesProyecto ?? []}
						year={section.anio}
						location={section.ubicacion ?? entry.data.ubicacion}
						accent={entry.data.accent}
					/>
				);
			}
			if (section._type === 'caseContext') {
				return (
					<SectionBand>
						<div class="grid gap-10 md:grid-cols-2">
							<div>
								<SectionHeader
									eyebrow={section.retoEyebrow ?? 'Reto'}
									title={section.retoTitle ?? 'Contexto inicial'}
									description={section.reto}
									badgeVariant="purple"
									headingWidth={section.headingWidth}
								/>
							</div>
							<div>
								<SectionHeader
									eyebrow={section.estrategiaEyebrow ?? 'Estrategia'}
									title={section.estrategiaTitle ?? 'Servicios aplicados'}
									description={section.estrategia}
									badgeVariant="cyan"
									headingWidth={section.headingWidth}
								/>
								<ul class="mt-6 flex-wrap gap-2 flex">
									{relatedServices.map((service) => (
										<li>
											<a
												href={`/servicios/${service.id}`}
												class="rounded-full border border-border px-3 py-1 font-display text-xs font-medium text-ink no-underline"
											>
												{service.nombre ?? service.id}
											</a>
										</li>
									))}
								</ul>
								{((section.sitioWeb ?? entry.data.sitioWeb) || (section.redSocial ?? entry.data.redSocial)) ? (
									<div class="mt-5 pt-4 border-t border-border/40 flex flex-wrap items-center gap-2.5">
										{(section.sitioWeb ?? entry.data.sitioWeb) ? (
											<a
												href={section.sitioWeb ?? entry.data.sitioWeb}
												target="_blank"
												rel="noopener noreferrer"
												class="group inline-flex items-center gap-2 rounded-full border border-border/80 bg-surface/60 px-3.5 py-1.5 font-display text-xs font-medium text-ink transition-all hover:border-cyan hover:text-cyan hover:bg-surface no-underline"
											>
												<svg class="h-3.5 w-3.5 text-muted transition-colors group-hover:text-cyan" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
													<circle cx="12" cy="12" r="10" />
													<line x1="2" y1="12" x2="22" y2="12" />
													<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
												</svg>
												<span>Sitio web oficial</span>
												<svg class="h-3 w-3 text-muted transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-cyan" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
													<path d="M7 17L17 7M17 7H7M17 7V17" />
												</svg>
											</a>
										) : null}

										{(section.redSocial ?? entry.data.redSocial) ? (() => {
											const social = section.redSocial ?? entry.data.redSocial!;
											const isIg = !social.plataforma || social.plataforma === 'instagram';
											const isLi = social.plataforma === 'linkedin';
											const isFb = social.plataforma === 'facebook';
											const label = social.handle || (isIg ? 'Instagram oficial' : isLi ? 'LinkedIn oficial' : isFb ? 'Facebook oficial' : 'Red social');
											const hoverClass = isIg ? 'hover:border-orange hover:text-orange' : 'hover:border-cyan hover:text-cyan';
											const iconHoverClass = isIg ? 'group-hover:text-orange' : 'group-hover:text-cyan';

											return (
												<a
													href={social.url}
													target="_blank"
													rel="noopener noreferrer"
													class={`group inline-flex items-center gap-2 rounded-full border border-border/80 bg-surface/60 px-3.5 py-1.5 font-display text-xs font-medium text-ink transition-all ${hoverClass} hover:bg-surface no-underline`}
												>
													{isIg ? (
														<svg class={`h-3.5 w-3.5 text-muted transition-colors ${iconHoverClass}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
															<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
															<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
															<line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
														</svg>
													) : isLi ? (
														<svg class={`h-3.5 w-3.5 text-muted transition-colors ${iconHoverClass}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
															<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
															<rect width="4" height="12" x="2" y="9"/>
															<circle cx="4" cy="4" r="2"/>
														</svg>
													) : isFb ? (
														<svg class={`h-3.5 w-3.5 text-muted transition-colors ${iconHoverClass}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
															<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
														</svg>
													) : (
														<svg class={`h-3.5 w-3.5 text-muted transition-colors ${iconHoverClass}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
															<circle cx="12" cy="12" r="10"/>
															<line x1="2" y1="12" x2="22" y2="12"/>
															<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
														</svg>
													)}
													<span>{label}</span>
													<svg class={`h-3 w-3 text-muted transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 ${iconHoverClass}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
														<path d="M7 17L17 7M17 7H7M17 7V17" />
													</svg>
												</a>
											);
										})() : null}
									</div>
								) : null}
							</div>
						</div>
					</SectionBand>
				);
			}
			if (section._type === 'caseProcess' && section.fases.length) {
				return (
					<>
						<ProcessPhases
							client:visible
							phases={section.fases.map((fase, index) => ({
								index: String(index + 1).padStart(2, '0'),
								title: fase.title,
								description: fase.description,
								icon: fase.icon,
							}))}
							eyebrow={section.eyebrow ?? 'Ejecución'}
							title={section.title ?? 'Cómo se hizo el trabajo'}
							description={section.description}
							headingWidth={section.headingWidth}
						/>
						{matchingSocialBrand && !sections.some((s) => s._type === 'instagramPhone') ? (
							<InstagramPhoneSwitcher
								client:visible
								brand={matchingSocialBrand}
								hideSwitcher={true}
								tone="canvas"
							/>
						) : null}
					</>
				);
			}
			if (section._type === 'instagramPhone') {
				const brandFromSection: BrandProfile | undefined = (matchingSocialBrand?.posts && matchingSocialBrand.posts.length > 0)
					? matchingSocialBrand
					: section.username ? {
					id: section.username,
					name: section.displayName || entry.data.cliente,
					handle: section.username,
					category: section.bio || '',
					industryId: '',
					industryName: '',
					avatar: section.avatar || matchingSocialBrand?.avatar || '',
					bio: section.bio || matchingSocialBrand?.bio || '',
					stats: {
						posts: String(section.posts?.length || matchingSocialBrand?.stats.posts || '120'),
						followers: section.stats?.[0]?.value || matchingSocialBrand?.stats.followers || '12.4k',
						following: section.stats?.[1]?.value || matchingSocialBrand?.stats.following || '350',
					},
					highlights: matchingSocialBrand?.highlights || [],
					posts: (section.posts && section.posts.length > 0)
						? section.posts.map((p, pIdx) => ({
								id: `${section.username}-${pIdx}`,
								brandId: section.username ?? '',
								brandName: section.displayName || entry.data.cliente,
								brandHandle: section.username ?? '',
								brandAvatar: section.avatar || '',
								brandCategory: '',
								kind: p.kind,
								cover: p.poster || p.slides?.[0]?.src || '',
								slides: p.slides || [],
								caption: p.caption || '',
								videoUrl: p.videoUrl,
								stats: {},
								caseSlug: entry.id,
							}))
						: matchingSocialBrand?.posts || [],
				} : matchingSocialBrand;

				return (
					<InstagramPhoneSwitcher
						client:visible
						brandId={section.brandId || matchingSocialBrand?.id}
						brand={brandFromSection}
						eyebrow={section.eyebrow}
						title={section.title}
						description={section.description}
						tone={section.tone || 'canvas'}
						hideSwitcher={true}
					/>
				);
			}
			if (section._type === 'caseMetrics' && section.metricas.length) {
				return (
					<MetricsBand
						client:visible
						metrics={section.metricas.map((metric) => ({
							valor: metric.valor,
							label: metric.label,
							prefix: metric.prefix,
							suffix: metric.suffix,
							decimals: metric.decimals,
							detail:
								metric.antes && metric.despues
									? `De ${metric.antes} a ${metric.despues}`
									: metric.despues
										? metric.despues
										: undefined,
						}))}
						eyebrow={section.eyebrow}
						title={section.title}
						description={section.description}
						primaryLabel={section.primaryLabel}
						primaryHref={section.primaryHref}
						secondaryLabel={section.secondaryLabel}
						secondaryHref={section.secondaryHref}
						headingWidth={section.headingWidth}
					/>
				);
			}
			if (section._type === 'caseTestimonial' && section.quote) {
				return (
					<CaseStories
						client:visible
						id="testimonio"
						eyebrow={section.eyebrow ?? 'Testimonio'}
						title={section.title ?? `Lo que dice ${entry.data.cliente}`}
						description={section.description}
						stories={[
							{
								client: section.client || entry.data.cliente,
								quote: section.quote,
								name: section.name ?? entry.data.cliente,
								role: section.role ?? '',
								photo: section.photo,
								cover: entry.data.imagenesProyecto?.[0],
								stats: (section.quote ? entry.data.metricas : []).slice(0, 2).map(formatCaseStat),
								href: `/portafolio/${entry.id}`,
							},
						]}
						headingWidth={section.headingWidth}
					/>
				);
			}
			if (section._type === 'caseRelated' && related.length) {
				return (
					<SectionBand id="casos" tone="canvas">
						<div class="blog-index">
							<SectionHeader
								eyebrow={section.eyebrow ?? 'Casos'}
								title={section.title ?? 'Más casos de esta industria'}
								description={section.description}
								badgeVariant="lime"
								headingWidth={section.headingWidth}
							/>
							<CaseCards
								cases={related.map((item) => ({
									id: item.id,
									title: item.data.titulo,
									description: item.data.resumen,
									client: item.data.cliente,
									industry: industry?.data.nombre ?? item.data.cliente,
									industrySlug: item.data.industria.id,
									image: item.data.imagen || item.data.seo?.ogImage || postCoverUrl(`caso-${item.id}`, 800, 520),
									href: `/portafolio/${item.id}`,
								}))}
							/>
						</div>
					</SectionBand>
				);
			}
			if (section._type === 'instagramPhone' && section.username) {
				return (
					<InstagramPhone
						eyebrow={section.eyebrow}
						title={section.title}
						description={section.description}
						tone={section.tone}
						username={section.username}
						displayName={section.displayName}
						bio={section.bio}
						avatar={section.avatar}
						avatarAlt={section.avatarAlt}
						stats={section.stats}
						posts={section.posts}
					/>
				);
			}
			if (section._type === 'beforeAfter' && section.pairs.length) {
				return (
					<BeforeAfter
						client:visible
						eyebrow={section.eyebrow}
						title={section.title}
						description={section.description}
						badgeVariant={(section.badgeVariant || 'orange') as 'orange'}
						headingWidth={section.headingWidth}
						pairs={section.pairs}
					/>
				);
			}
			if (section._type === 'caseCta') {
				return (
					<FinalCta
						badge={section.badge}
						title={section.title ?? 'Agenda un diagnóstico similar'}
						description={section.description}
						primaryLabel={section.primaryLabel}
						primaryHref={section.primaryHref}
						headingWidth={section.headingWidth}
					/>
				);
			}
			return null;
		})}
	</main>
</Layout>
