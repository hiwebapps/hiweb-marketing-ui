---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import { getCases, getIndustries } from '../../lib/content';
import { BlogHero } from '../../components/sections/BlogHero';
import { CasesIndex } from '../../components/sections/CasesIndex';
import { SectionBand } from '../../components/sections/primitives/SectionBand';
import { FinalCta } from '../../components/sections/FinalCta';
import { breadcrumbSchema } from '../../lib/schema';
import { postCoverUrl } from '../../lib/blog';
import '../../components/sections/BlogHero.css';
import '../../components/sections/BlogIndex.css';

const industries = await getIndustries();
const cases = (await getCases()).sort((a, b) => {
	if (a.data.destacado !== b.data.destacado) return a.data.destacado ? -1 : 1;
	return a.data.cliente.localeCompare(b.data.cliente, 'es');
});
const industryName = Object.fromEntries(industries.map((item) => [item.id, item.data.nombre]));

const cards = cases.map((item) => ({
	id: item.id,
	title: item.data.titulo,
	description: item.data.resumen,
	client: item.data.cliente,
	outcome: item.data.resultadoFrase,
	industry: industryName[item.data.industria.id] ?? item.data.industria.id,
	industrySlug: item.data.industria.id,
	image: postCoverUrl(`caso-${item.id}`, 800, 520),
	href: `/portafolio/${item.id}`,
	featured: item.data.destacado,
}));
---

<Layout
	title="Casos de Éxito — Hiweb Marketing"
	description="Resultados propios y verificables. Solo empresas consolidadas, filtrables por industria."
	jsonLd={breadcrumbSchema([
		{ name: 'Inicio', href: '/' },
		{ name: 'Portafolio', href: '/portafolio' },
	])}
>
	<main>
		<BlogHero
			label="Casos de éxito"
			eyebrow="Portafolio / Casos"
			title="Resultados propios, solo con empresas consolidadas"
			description="Cliente, industria y un outcome que se puede leer en una línea. Sin portfolio ornamental."
		/>
		<SectionBand tone="canvas">
			<CasesIndex
				client:load
				cases={cards}
				industries={industries.map((item) => ({
					slug: item.id,
					nombre: item.data.nombre,
				}))}
			/>
		</SectionBand>
		<FinalCta client:load title="¿Un diagnóstico similar al de tu industria?" />
	</main>
</Layout>
