---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import { getCases, getCatalogIndex, getIndustries } from '../../lib/content';
import { BlogHero } from '../../components/sections/BlogHero';
import { CasesIndex } from '../../components/sections/CasesIndex';
import { SectionBand } from '../../components/sections/primitives/SectionBand';
import FinalCta from '../../components/sections/FinalCtaBand.astro';
import { breadcrumbSchema } from '../../lib/schema';
import { postCoverUrl } from '../../lib/blog';
import { WEBFLOW_CASES_INDEX } from '../../data/webflow-cases';
import '../../components/sections/BlogHero.css';
import '../../components/sections/BlogIndex.css';

const industries = await getIndustries();
const page = await getCatalogIndex('casesIndex');
const cases = (await getCases()).sort((a, b) => {
	if (a.data.destacado !== b.data.destacado) return a.data.destacado ? -1 : 1;
	return a.data.cliente.localeCompare(b.data.cliente, 'es');
});
const industryName = Object.fromEntries(industries.map((item) => [item.id, item.data.nombre]));

const cards = cases.map((item) => ({
	id: item.id,
	title: item.data.titulo,
	description: item.data.resumen,
	client: item.data.cliente,
	industry: industryName[item.data.industria.id] || item.data.cliente,
	industrySlug: item.data.industria.id,
	image: item.data.seo?.ogImage ?? postCoverUrl(`caso-${item.id}`, 800, 520),
	href: `/portafolio/${item.id}`,
	featured: item.data.destacado,
}));
---

<Layout
	title={page?.seo?.metaTitle ?? WEBFLOW_CASES_INDEX.seo.metaTitle ?? page?.title ?? WEBFLOW_CASES_INDEX.title}
	description={page?.seo?.metaDescription ?? WEBFLOW_CASES_INDEX.seo.metaDescription ?? page?.description ?? WEBFLOW_CASES_INDEX.description}
	noindex={page?.seo?.noindex}
	canonical={page?.seo?.canonicalPath}
	jsonLd={breadcrumbSchema([
		{ name: 'Inicio', href: '/' },
		{ name: 'Portafolio', href: '/portafolio' },
	])}
>
	<main>
		<BlogHero
			label={page?.label ?? 'Casos de éxito'}
			eyebrow={page?.eyebrow ?? WEBFLOW_CASES_INDEX.eyebrow}
			title={page?.title ?? WEBFLOW_CASES_INDEX.title}
			description={page?.description ?? WEBFLOW_CASES_INDEX.description}
			headingWidth={page?.headingWidth}
		/>
		<SectionBand tone="canvas">
			<CasesIndex
				client:load
				cases={cards}
				industries={industries.map((item) => ({
					slug: item.id,
					nombre: item.data.nombre,
				}))}
			/>
		</SectionBand>
		<FinalCta
			title={page?.closingTitle ?? '¿Un diagnóstico similar al de tu industria?'}
			headingWidth={page?.closingHeadingWidth}
		/>
	</main>
</Layout>
