---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import { Button } from '../components/ui';

const title = 'Listo — Hiweb Marketing';
const description = 'Recibimos tu solicitud. Hiweb te confirma el siguiente paso por correo o WhatsApp.';

const formSteps = [
  {
    title: 'Revisamos lo que nos contaste',
    text: 'Industria, tamaño y servicios. Con eso preparamos la conversación.',
  },
  {
    title: 'Contacto en menos de 24 h hábiles',
    text: 'Un especialista te escribe por WhatsApp o correo con el siguiente paso.',
  },
  {
    title: 'Puedes apartar horario ahora',
    text: 'Si prefieres no esperar el mensaje, elige día y hora en el calendario.',
  },
];

const calendarSteps = [
  {
    title: 'Confirmación por correo',
    text: 'Revisa tu bandeja. Ahí está el día, la hora y el enlace de la llamada.',
  },
  {
    title: 'La llamada es con tu equipo',
    text: 'Hablas con las personas que trabajarían tu cuenta, no con un filtro comercial.',
  },
  {
    title: 'Llega con el objetivo claro',
    text: 'Ten a mano tu sitio y qué resultado quieres en los próximos meses.',
  },
];
---

<Layout
  title={title}
  description={description}
  noindex={true}
  minimalNav={true}
  minimalFooter={true}
  landingNavBadge=""
>
  <script is:inline>
    document.documentElement.dataset.gracias =
      new URLSearchParams(location.search).get('origen') === 'agenda' ? 'agenda' : 'formulario';
  </script>
  <style is:inline>
    html:not([data-gracias="agenda"]) .gracias-agenda { display: none; }
    html[data-gracias="agenda"] .gracias-form { display: none; }
  </style>

  <main class="min-h-[75vh] flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl w-full mx-auto text-center">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-600 mb-6 shadow-sm">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
        </svg>
      </div>

      <div class="gracias-form">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface border border-border text-xs font-medium text-ink-soft mb-4">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Solicitud recibida</span>
        </div>
        <h1 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl tracking-tight text-ink mb-4">
          Recibimos tus datos
        </h1>
        <p class="text-base sm:text-lg text-muted max-w-xl mx-auto mb-10 leading-relaxed">
          Un especialista de Hiweb te escribe en menos de 24 horas hábiles por WhatsApp o correo.
        </p>
      </div>

      <div class="gracias-agenda">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface border border-border text-xs font-medium text-ink-soft mb-4">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Llamada confirmada</span>
        </div>
        <h1 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl tracking-tight text-ink mb-4">
          Tu llamada quedó agendada
        </h1>
        <p class="text-base sm:text-lg text-muted max-w-xl mx-auto mb-10 leading-relaxed">
          Te enviamos la confirmación por correo. El equipo de Hiweb te espera en el horario que elegiste.
        </p>
      </div>

      <div class="rounded-2xl border border-border bg-surface p-6 sm:p-8 text-left mb-10 shadow-sm">
        <h2 class="font-display font-semibold text-lg text-ink mb-5">
          ¿Qué va a pasar ahora?
        </h2>
        <ol class="gracias-form space-y-4 text-sm sm:text-base text-ink-soft">
          {formSteps.map((step, index) => (
            <li class="flex items-start gap-3.5">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-ink text-canvas text-xs font-semibold flex items-center justify-center mt-0.5">
                {index + 1}
              </span>
              <div>
                <strong class="font-semibold text-ink">{step.title}</strong>
                <p class="text-muted text-xs sm:text-sm mt-0.5">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
        <ol class="gracias-agenda space-y-4 text-sm sm:text-base text-ink-soft">
          {calendarSteps.map((step, index) => (
            <li class="flex items-start gap-3.5">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-ink text-canvas text-xs font-semibold flex items-center justify-center mt-0.5">
                {index + 1}
              </span>
              <div>
                <strong class="font-semibold text-ink">{step.title}</strong>
                <p class="text-muted text-xs sm:text-sm mt-0.5">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="gracias-form rounded-2xl border border-border bg-canvas p-6 text-center">
        <p class="text-xs sm:text-sm text-muted mb-4">
          ¿Prefieres apartar tu lugar en la agenda de una vez?
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <Button href="/calendario" variant="primary" size="md">
            Agendar videollamada
          </Button>
          <Button href="/" variant="secondary" size="md">
            Volver al inicio
          </Button>
        </div>
      </div>

      <div class="gracias-agenda">
        <Button href="/" variant="secondary" size="md">
          Volver al inicio
        </Button>
      </div>
    </div>
  </main>

  <script is:inline>
    (function () {
      try {
        var origen = new URLSearchParams(location.search).get('origen') === 'agenda' ? 'agenda' : 'formulario';
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'generate_lead',
          conversion_source: origen,
          page_path: window.location.pathname,
        });
        window.dataLayer.push({
          event: 'openai_conversion',
          conversion_name: 'lead_completed',
          conversion_source: origen,
        });
      } catch (err) {
        console.warn('Analytics event push error:', err);
      }
    })();
  </script>
</Layout>
