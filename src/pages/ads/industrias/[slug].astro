---
import LpDocument from '../../../components/lp/LpDocument.astro';
import { getLpPage, lpDetailPaths } from '../../../lib/content/lp-load';
import { notFound } from '../../../lib/content/resolve-entry';

export const prerender = true;

export async function getStaticPaths() {
	const pages = await lpDetailPaths('industrias');
	return pages.map((page) => ({ params: { slug: page.slug }, props: { path: page.path } }));
}

// Staging renders on request, so getStaticPaths props are missing there.
const page = await getLpPage(Astro.props.path ?? `/ads/industrias/${Astro.params.slug ?? ''}`);
if (!page) return notFound();
---

<LpDocument page={page} />
