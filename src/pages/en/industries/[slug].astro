---
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import { getCases, getServices, industryStaticPaths } from '../../../lib/content';
import { IndustryHero } from '../../../components/sections/IndustryHero';
import { IndustryServices } from '../../../components/sections/IndustryServices';
import { PillarGrid } from '../../../components/sections/PillarGrid';
import { CaseStories } from '../../../components/sections/CaseStories';
import { FaqSection } from '../../../components/sections/FaqSection';
import FinalCta from '../../../components/sections/FinalCtaBand.astro';
import IndustryPageSection from '../../../components/sections/IndustryPageSection.astro';
import { breadcrumbSchema, faqSchema } from '../../../lib/schema';
import { industryServiceDescription } from '../../../data/industryServices';
import { serviceContentKey } from '../../../lib/en-slugs';
import type { BadgeVariant } from '../../../components/ui';
import { formatCaseStat } from '../../../lib/content/format';
import { notFound, resolveEntry } from '../../../lib/content/resolve-entry';
import type { IndustryRecord, IndustrySection } from '../../../lib/content/types';
import '../../../components/sections/CaseStories.css';
import '../../../components/sections/FaqSection.css';
import '../../../components/sections/IndustryServices.css';

export async function getStaticPaths() {
	return industryStaticPaths('en');
}

interface Props {
	entry: IndustryRecord;
}

const entry = await resolveEntry<IndustryRecord>(Astro.props.entry, Astro.params.slug, () =>
	industryStaticPaths('en'),
);
if (!entry) return notFound();
const services = await getServices('en');
const allCases = await getCases('en');
const cases = allCases.filter(
	(item) => item.data.industria.id === entry.id || item.data.industria.id === entry.alternateSlug,
);
const fallbackCases = allCases.filter((item) => item.data.destacado || item.data.testimonio?.quote).slice(0, 3);
const displayCases = cases.length > 0 ? cases : fallbackCases;
const heroImage = entry.data.heroImage ?? `/images/industries/${entry.id}.jpg`;
const industryHeroBadges: { label: string; variant: BadgeVariant }[] = [
	{ label: entry.data.nombre, variant: 'lime' },
];
const blurbByService = Object.fromEntries(entry.data.serviceBlurbs.map((item) => [item.serviceSlug, item]));

const industryServices = services.map((item) => {
	const blurb = blurbByService[item.id] ?? blurbByService[serviceContentKey(item.id)];
	return {
		slug: item.id,
		nombre: blurb?.nombre || item.data.nombre,
		description:
			blurb?.description ||
			industryServiceDescription(entry.id, serviceContentKey(item.id), entry.data.nombre),
		icon: blurb?.icon || item.data.cardIcon,
	};
});

function cardsFor(section: IndustrySection) {
	if (section._type !== 'industryServices' || !section.items?.length) return industryServices;
	const cards = section.items.flatMap((item) => {
		if (!item.slug) return [];
		return [
			{
				slug: item.slug,
				nombre: item.nombre || services.find((service) => service.id === item.slug)?.data.nombre || item.slug,
				description:
					item.description ||
					industryServiceDescription(entry.id, serviceContentKey(item.slug), entry.data.nombre),
				icon: item.icon,
			},
		];
	});
	return cards.length ? cards : industryServices;
}

const allSections = entry.data.sections ?? [];
const pageSections = allSections.filter((section) => !section.hidden);

const caseStories = displayCases.map((item) => ({
	client: item.data.cliente || item.data.testimonio?.client,
	quote: item.data.testimonio?.quote ?? item.data.resumen,
	name: '',
	role: '',
	cover: item.data.imagenesProyecto?.[0] || item.data.imagen,
	stats: item.data.testimonio?.stats?.length
		? item.data.testimonio.stats
		: item.data.metricas.slice(0, 2).map(formatCaseStat),
	href: `/en/success-stories/${item.id}`,
}));
---

<Layout
	lang="en"
	title={entry.data.seo?.metaTitle ?? `${entry.data.nombre} — Hiweb Marketing`}
	description={entry.data.seo?.metaDescription ?? entry.data.heroDescription}
	ogImage={entry.data.seo?.ogImage ?? heroImage}
	noindex={entry.data.seo?.noindex}
	canonical={entry.data.seo?.canonicalPath}
	alternates={
		entry.alternateSlug
			? { es: `/industrias/${entry.alternateSlug}`, en: `/en/industries/${entry.id}` }
			: undefined
	}
	jsonLd={[
		breadcrumbSchema([
			{ name: 'Home', href: '/en' },
			{ name: entry.data.nombre, href: `/en/industries/${entry.id}` },
		]),
		...(allSections.length === 0 || pageSections.some((section) => section._type === 'industryFaq')
			? [faqSchema(entry.data.faqs)]
			: []),
	]}
>
	<main>
		{allSections.length ? (
			pageSections.map((section) => (
				<IndustryPageSection
					key={section._type}
					section={section}
					nombre={entry.data.nombre}
					heroFallback={heroImage}
					services={cardsFor(section)}
					stories={caseStories}
					hasCases={cases.length > 0}
					hrefPrefix="/en/services"
				/>
			))
		) : (
		<>
		<IndustryHero
			title={entry.data.heroTitle}
			description={entry.data.heroDescription}
			image={heroImage}
			imageAlt={entry.data.heroImageAlt}
			badges={industryHeroBadges}
			ctaLabel={entry.data.heroCtaLabel}
			ctaHref="#casos"
		/>
		<PillarGrid
			eyebrow={entry.data.whyEyebrow}
			title={entry.data.whyTitle}
			description={entry.data.whyDescription}
			pillars={entry.data.porQue}
			tone="canvas"
		/>
		<IndustryServices
			industryName={entry.data.nombre}
			services={industryServices}
			title={entry.data.servicesTitle}
			description={entry.data.servicesDescription}
			hrefPrefix="/en/services"
			ctaLabel={entry.data.servicesCtaLabel}
			tagLabel={entry.data.servicesTag}
			tone="canvas"
		/>
		<CaseStories
			client:visible
			locale="en"
			eyebrow={entry.data.casesEyebrow}
			title={entry.data.casesTitle}
			description={cases.length ? entry.data.casesDescription : entry.data.casesEmpty}
			stories={caseStories}
		/>
		<FaqSection
			client:visible
			items={entry.data.faqs}
			title={entry.data.faqTitle}
			withSchema={false}
			columns={2}
		/>
		<FinalCta locale="en" title={entry.data.closingTitle} description={entry.data.closingDescription} />
		</>
		)}
	</main>
</Layout>
