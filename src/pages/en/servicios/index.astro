---
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import { getCases, getCatalogIndex, getHomeCopy, getIndustries, getIndustriesIndex, getServices } from '../../../lib/content';
import { PageHero } from '../../../components/sections/PageHero';
import { ServiceGrid } from '../../../components/sections/ServiceGrid';
import { IndustryGrid } from '../../../components/sections/IndustryGrid';
import { ProcessPhases } from '../../../components/sections/ProcessPhases';
import { CasePreview } from '../../../components/sections/CasePreview';
import { FinalCta } from '../../../components/sections/FinalCta';
import { breadcrumbSchema } from '../../../lib/schema';
const services = await getServices('en');
const industries = await getIndustries('en');
const industriesIndex = await getIndustriesIndex();
const cases = await getCases();
const home = await getHomeCopy('en');
const page = await getCatalogIndex('servicesIndex-en');
const industryName = Object.fromEntries(industries.map((item) => [item.id, item.data.nombre]));
const intro = {
	eyebrow: page?.eyebrow ?? home.serviceIntro?.eyebrow ?? 'Services',
	title: page?.title ?? home.serviceIntro?.title ?? 'Digital marketing services in México',
	description:
		page?.description ??
		home.serviceIntro?.description ??
		'We unify strategy, execution and measurement to scale demand and sales. Choose a service or work on a full stack.',
};
---

<Layout
	lang="en"
	title={page?.seo?.metaTitle ?? intro.title}
	description={page?.seo?.metaDescription ?? intro.description}
	noindex={page?.seo?.noindex}
	canonical={page?.seo?.canonicalPath}
	alternates={{ es: '/servicios', en: '/en/servicios' }}
	jsonLd={breadcrumbSchema([
		{ name: 'Home', href: '/en' },
		{ name: 'Services', href: '/en/servicios' },
	])}
>
	<main>
		<PageHero eyebrow={intro.eyebrow} title={intro.title} description={intro.description} />
		<ServiceGrid
			services={services.map((item) => ({
				slug: item.id,
				nombre: item.data.nombre,
				tagline: item.data.tagline,
			}))}
			eyebrow={intro.eyebrow}
			title={intro.title}
			description={intro.description}
			hrefPrefix="/en/servicios"
		/>
		<IndustryGrid
			client:visible
			industries={industries.map((item) => ({
				slug: item.id,
				nombre: item.data.nombre,
				tagline: item.data.tagline,
				puntos: item.data.porQue.map((punto) => punto.title),
			}))}
			eyebrow={industriesIndex?.eyebrow}
			title={page?.sectionTitle ?? industriesIndex?.title}
			description={industriesIndex?.description}
			hrefPrefix="/en/industrias"
			ctaLabel={industriesIndex?.cardCtaLabel}
			tone="surface"
		/>
		<ProcessPhases client:visible phases={home.process ?? []} tone="canvas" />
		<CasePreview
			cases={cases.slice(0, 3).map((item) => ({
				client: item.data.cliente,
				industry: industryName[item.data.industria.id] ?? item.data.industria.id,
				title: item.data.titulo,
				summary: item.data.resumen,
				href: `/portafolio/${item.id}`,
				accent: item.data.accent,
			}))}
		/>
		<FinalCta client:load title={page?.closingTitle ?? 'Elige palanca después del diagnóstico'} />
	</main>
</Layout>
