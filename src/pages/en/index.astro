---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import { HeroStudioA } from '../../components/sections/HeroStudioA';
import { IndustryGrid } from '../../components/sections/IndustryGrid';
import { CaseStories } from '../../components/sections/CaseStories';
import { ProcessPhases } from '../../components/sections/ProcessPhases';
import { MetricsBand } from '../../components/sections/MetricsBand';
import { FaqSection } from '../../components/sections/FaqSection';
import { FinalCta } from '../../components/sections/FinalCta';
import { PillarGrid } from '../../components/sections/PillarGrid';
import { ServiceGrid } from '../../components/sections/ServiceGrid';
import { TeamGrid } from '../../components/sections/TeamGrid';
import { homePillarsWithIcons } from '../../data/webflow-home';
import '../../components/sections/TeamGrid.css';
import '../../components/sections/FaqSection.css';
import '../../components/sections/CaseStories.css';
import '../../components/sections/MetricsBand.css';
import { faqSchema } from '../../lib/schema';
import { getCases, getHomeCopy, getIndustries, getIndustriesIndex, getServices } from '../../lib/content';
import { SITE } from '../../data/site';

const home = await getHomeCopy('en');
const industriesIndex = await getIndustriesIndex();
const industryCards = home.industryCards?.length
	? home.industryCards.map((item) => ({
			slug: item.id,
			nombre: item.nombre,
			tagline: item.tagline,
			puntos: item.puntos,
		}))
	: (await getIndustries()).map((item) => ({
			slug: item.id,
			nombre: item.data.nombre,
			tagline: item.data.tagline,
			puntos: item.data.porQue.map((punto) => punto.title),
		}));
const services = home.serviceCards?.length
	? home.serviceCards
	: (await getServices()).map((item) => ({
			id: item.id,
			nombre: item.data.nombre,
			tagline: item.data.tagline,
		}));
const industryLabel: Record<string, string> = {
	'turismo-hoteleria': 'Turismo',
	saas: 'SaaS',
	salud: 'Salud',
	manufactura: 'Manufactura',
	restaurantes: 'Restaurantes',
	inmobiliarias: 'Inmobiliarias',
};
const heroSlides = (home.heroCases?.length
	? home.heroCases
			.filter((item) => item.image)
			.map((item) => ({
				image: item.image as string,
				title: item.industriaId && industryLabel[item.industriaId]
					? `${item.cliente} · ${industryLabel[item.industriaId]}`
					: item.cliente,
				href: `/portafolio/${item.id}`,
			}))
	: (await getCases())
			.filter((item) => item.data.seo?.ogImage)
			.sort((a, b) => {
				if (a.data.destacado !== b.data.destacado) return a.data.destacado ? -1 : 1;
				return a.data.cliente.localeCompare(b.data.cliente, 'es');
			})
			.map((item) => {
				const industry = industryLabel[item.data.industria.id];
				return {
					image: item.data.seo?.ogImage as string,
					title: industry ? `${item.data.cliente} · ${industry}` : item.data.cliente,
					href: `/portafolio/${item.id}`,
				};
			}));
const faqCategories = home.faqCategories ?? [];
const faqs = faqCategories.flatMap((category) => category.items);
const stories = (home.testimonials ?? []).map((item) => ({
	client: item.client,
	quote: item.quote,
	name: item.name,
	role: item.role ?? '',
	stats: [],
}));
const metrics = (home.metrics ?? []).map((item) => ({
	valor: item.valor,
	label: item.label,
	prefix: item.prefix,
	suffix: item.suffix,
	decimals: item.decimals,
}));
const sectionOrder = home.sectionOrder?.length
	? home.sectionOrder
	: [
			'homeHero',
			'homePillars',
			'homeServices',
			'homeIndustries',
			'homeStories',
			'homeProcess',
			'homeMetrics',
			'homeTeam',
			'homeFaq',
			'homeCta',
		];
---

<Layout
	title={home.seo?.metaTitle ?? 'Hiweb Marketing — Partner estratégico'}
	description={home.seo?.metaDescription ?? SITE.tagline}
	ogImage={home.seo?.ogImage}
	jsonLd={faqSchema(faqs)}
	lang="en"
>
	<main>
		{sectionOrder.map((type) => {
			if (type === 'homeHero') {
				return (
					<HeroStudioA
						key={type}
						client:load
						title={home.heroTitle}
						description={home.heroLead}
						primaryLabel={home.primaryCta?.label}
						primaryHref={home.primaryCta?.href}
						secondaryLabel={home.secondaryCta?.label}
						secondaryHref={home.secondaryCta?.href}
						cardCta="see project"
						slides={heroSlides}
					/>
				);
			}
			if (type === 'homePillars') {
				return (
					<PillarGrid
						key={type}
						pillars={homePillarsWithIcons(home.pillars)}
						tone="canvas"
						eyebrow={home.pillarIntro?.eyebrow}
						title={home.pillarIntro?.title}
						description={home.pillarIntro?.description}
						ctaLabel={home.pillarCtaLabel}
					/>
				);
			}
			if (type === 'homeServices') {
				return (
					<ServiceGrid
						key={type}
						services={services.map((item) => ({
							slug: item.id,
							nombre: item.nombre,
							tagline: item.tagline,
						}))}
						eyebrow={home.serviceIntro?.eyebrow}
						title={home.serviceIntro?.title}
						description={home.serviceIntro?.description}
						hrefPrefix="/en/servicios"
					/>
				);
			}
			if (type === 'homeIndustries') {
				return (
					<IndustryGrid
						key={type}
						client:visible
						tone="canvas"
						eyebrow={home.industryIntro?.eyebrow}
						title={home.industryIntro?.title}
						description={home.industryIntro?.description}
						industries={industryCards}
						hrefPrefix="/en/industrias"
						ctaLabel={industriesIndex?.cardCtaLabel}
					/>
				);
			}
			if (type === 'homeStories') {
				return (
					<CaseStories
						key={type}
						client:visible
						stories={stories}
						eyebrow={home.storiesIntro?.eyebrow}
						title={home.storiesIntro?.title}
						description={home.storiesIntro?.description}
					/>
				);
			}
			if (type === 'homeProcess') {
				return (
					<ProcessPhases
						key={type}
						client:visible
						phases={home.process ?? []}
						tone="canvas"
						eyebrow={home.processIntro?.eyebrow}
						title={home.processIntro?.title}
						description={home.processIntro?.description}
					/>
				);
			}
			if (type === 'homeMetrics' && metrics.length) {
				return (
					<MetricsBand
						key={type}
						client:visible
						metrics={metrics}
						eyebrow={home.metricsIntro?.eyebrow}
						title={home.metricsIntro?.title}
						titleMuted={home.metricsIntro?.titleMuted}
						description={home.metricsIntro?.description}
						primaryLabel={home.primaryCta?.label}
						primaryHref={home.primaryCta?.href}
						secondaryLabel={home.secondaryCta?.label}
						secondaryHref={home.secondaryCta?.href}
					/>
				);
			}
			if (type === 'homeTeam') {
				return (
					<TeamGrid
						key={type}
						client:visible
						limit={4}
						eyebrow={home.team?.eyebrow}
						title={home.team?.title}
						description={home.team?.description}
						ctaLabel={home.team?.ctaLabel ?? 'Conoce a todo el equipo'}
						ctaHref={home.team?.ctaHref ?? '/nosotros#nosotros'}
					/>
				);
			}
			if (type === 'homeFaq') {
				return (
					<FaqSection
						key={type}
						client:visible
						categories={faqCategories}
						eyebrow={home.faqIntro?.eyebrow}
						title={home.faqIntro?.title}
						description={home.faqIntro?.description}
					/>
				);
			}
			if (type === 'homeCta') {
				return (
					<FinalCta
						key={type}
						client:load
						badge={home.closing?.badge}
						title={home.closing?.title}
						description={home.closing?.description}
						primaryLabel={home.closing?.primaryCta?.label}
						primaryHref={home.closing?.primaryCta?.href}
					/>
				);
			}
			return null;
		})}
	</main>
</Layout>
