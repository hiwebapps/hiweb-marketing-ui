---
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import { getCatalogIndex, getPosts, getServices } from '../../../lib/content';
import { BlogHero } from '../../../components/sections/BlogHero';
import { BlogIndex } from '../../../components/sections/BlogIndex';
import { SectionBand } from '../../../components/sections/primitives/SectionBand';
import { FinalCta } from '../../../components/sections/FinalCta';
import { breadcrumbSchema } from '../../../lib/schema';
import { BLOG_READING_MINUTES, postCoverUrl } from '../../../lib/blog';
import '../../../components/sections/BlogHero.css';
import '../../../components/sections/BlogIndex.css';

const [posts, services, page] = await Promise.all([
	getPosts('en'),
	getServices('en'),
	getCatalogIndex('blogIndex-en'),
]);
const sorted = posts.sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());
const serviceName = Object.fromEntries(services.map((service) => [service.id, service.data.nombre]));

const cards = sorted.map((post) => {
	const servicio = post.data.categoriaServicio?.id;
	return {
		id: post.id,
		title: post.data.title,
		description: post.data.description,
		keyword: post.data.keyword,
		autor: post.data.autor,
		fecha: post.data.fecha.toLocaleDateString('en-US', {
			day: 'numeric',
			month: 'short',
			year: 'numeric',
		}),
		featured: post.data.featured,
		industria: post.data.categoriaIndustria?.id,
		servicio,
		servicioNombre: post.data.categoriaServicio?.nombre ?? (servicio ? serviceName[servicio] : undefined),
		readingMinutes: BLOG_READING_MINUTES,
		image: post.coverUrl ?? postCoverUrl(post.id, 800, 520),
		ctaLabel: page?.featuredCta ?? 'Read article',
		href: `/en/blogs/${post.id}`,
	};
});

const featured = cards.find((post) => post.featured) ?? cards[0];
const serviceFilters = services
	.slice()
	.sort((a, b) => a.data.orden - b.data.orden)
	.map((service) => ({ id: service.id, nombre: service.data.nombre }));
---

<Layout
	lang="en"
	title={page?.seo?.metaTitle ?? 'Blog — Hiweb Marketing'}
	description={page?.seo?.metaDescription ?? page?.description ?? 'Discover the latest news and trends in the world of digital marketing. Learn about SEO, Design, Web Development, and more!'}
	noindex={page?.seo?.noindex}
	canonical={page?.seo?.canonicalPath}
	alternates={{ es: '/blog', en: '/en/blogs' }}
	jsonLd={breadcrumbSchema([
		{ name: 'Home', href: '/en' },
		{ name: 'Blog', href: '/en/blogs' },
	])}
>
	<main>
		{featured ? (
			<BlogHero
				eyebrow={page?.eyebrow ?? 'Resources / Blog'}
				title={page?.title ?? 'Latest blogs'}
				description={page?.description ?? 'Discover the latest news and trends in the world of digital marketing. Learn about SEO, Design, Web Development, and more!'}
				readingSuffix={page?.readingSuffix ?? 'min read'}
				featured={{
					id: featured.id,
					title: featured.title,
					description: featured.description,
					servicioNombre: featured.servicioNombre,
					readingMinutes: featured.readingMinutes,
					image: featured.image,
					ctaLabel: page?.featuredCta ?? 'Read article',
					href: featured.href,
				}}
			/>
		) : null}
		<SectionBand tone="canvas">
			<BlogIndex
				client:load
				posts={cards}
				services={serviceFilters}
				title={page?.listTitle ?? 'All articles'}
				description={page?.listDescription ?? 'Filter by service. Each piece links to work we actually deliver.'}
				hrefPrefix="/en/blogs"
				allLabel={page?.allLabel ?? 'All'}
				filterLabel={page?.filterLabel ?? 'Filter by service'}
				readingSuffix={page?.readingSuffix ?? 'min read'}
			/>
		</SectionBand>
		<FinalCta client:load title={page?.closingTitle ?? 'Want to apply this to your business?'} />
	</main>
</Layout>
