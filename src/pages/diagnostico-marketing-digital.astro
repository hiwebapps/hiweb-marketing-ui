---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import { PageHero } from '../components/sections/PageHero';
import { MarketingQuiz } from '../components/growth/MarketingQuiz';
import { getSitePage } from '../lib/content';
import { breadcrumbSchema } from '../lib/schema';

const page = await getSitePage('page-diagnostico');
const title = page.title;
const description = page.description;
---

<Layout
	title={page.metaTitle || `${title} — Hiweb Marketing`}
	description={page.metaDescription || description}
	canonical="/diagnostico-marketing-digital"
	jsonLd={breadcrumbSchema([
		{ name: 'Inicio', href: '/' },
		{ name: title, href: '/diagnostico-marketing-digital' },
	])}
>
	<main>
		<PageHero eyebrow={page.eyebrow} title={title} description={description} />
		<MarketingQuiz client:load />
	</main>
</Layout>
