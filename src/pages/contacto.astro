---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import ContactTabs from '../components/sections/ContactTabs.astro';
import { getCalendarPage, getContactPage, getSiteSettings } from '../lib/content';
import { breadcrumbSchema } from '../lib/schema';

const contact = await getContactPage();
const calendar = await getCalendarPage('es');
const site = await getSiteSettings();
---

<Layout
	title={contact.metaTitle}
	description={contact.metaDescription}
	noindex={contact.noindex}
	canonical={contact.canonicalPath}
	alternates={{ es: '/contacto', en: '/en/contact' }}
	jsonLd={[
		breadcrumbSchema([
			{ name: 'Inicio', href: '/' },
			{ name: 'Contacto', href: '/contacto' },
		]),
	]}
>
	<main>
		<ContactTabs contact={contact} calendar={calendar} site={site} />
	</main>
	<script src="../scripts/contact-form.ts"></script>
</Layout>
