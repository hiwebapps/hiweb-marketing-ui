---
import '../styles/global.css';
import '../components/sections/SiteNav.css';
import '../components/sections/SiteFooter.css';
import '../components/sections/FinalCta.css';
import '../components/sections/IndustryHero.css';
import '../components/sections/CaseStories.css';
import '../components/sections/FaqSection.css';
import { SiteNav } from '../components/sections/SiteNav';
import { SiteFooter } from '../components/sections/SiteFooter';
import { ScrollIndicator } from '../components/effects/ScrollIndicator';
import { SITE } from '../data/site';

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	/** Kept for callers; this preview is always noindex. */
	noindex?: boolean;
	ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | object | object[];
}

const {
	title = 'Hiweb Marketing — Partner estratégico',
	description = SITE.tagline,
	canonical,
	ogImage = '/favicon.svg',
} = Astro.props;

const canonicalUrl = canonical
	?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href);
const ogImageUrl = ogImage.startsWith('http')
	? ogImage
	: new URL(ogImage, Astro.site ?? Astro.url).href;

---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
		<meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<link
			rel="preload"
			href="/fonts/clash-display/ClashDisplay-Semibold.otf"
			as="font"
			type="font/otf"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/inter/Inter-Variable.ttf"
			as="font"
			type="font/ttf"
			crossorigin
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline>
			document.documentElement.classList.add('motion-ready');
			window.setTimeout(function () {
				if (!window.__HIWEB_MOTION__) {
					document.documentElement.classList.remove('motion-ready');
				}
			}, 2500);
		</script>
	</head>
	<body id="top">
		<SiteNav client:load />
		<ScrollIndicator client:load />
		<slot />
		<SiteFooter client:idle />
		<script src="../scripts/motion.ts"></script>
	</body>
</html>
