---
import '../styles/global.css';
import '../components/sections/SiteNav.css';
import '../components/sections/SiteFooter.css';
import '../components/sections/FinalCta.css';
import '../components/sections/IndustryHero.css';
import '../components/sections/CaseStories.css';
import '../components/sections/FaqSection.css';
import { SiteNav } from '../components/sections/SiteNav';
import { SiteFooter } from '../components/sections/SiteFooter';
import { ScrollIndicator } from '../components/effects/ScrollIndicator';
import { getFavicon, getFooter, getNavigation, getSiteSettings } from '../lib/content';
import { organizationSchema, websiteSchema } from '../lib/schema';
import { jsonLdString } from '../lib/json-ld';
import { DEFAULT_OG_IMAGE, ROBOTS_NOINDEX, absoluteUrl, shouldNoIndex } from '../lib/seo';

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	/** Force noindex even after cutover (legal, kits, or the page's own checkbox). */
	noindex?: boolean;
	ogImage?: string;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[] | object | object[];
	lang?: 'es' | 'en';
	alternates?: { es?: string; en?: string };
}

const {
	title: rawTitle = 'Hiweb Marketing — Partner estratégico',
	canonical,
	noindex: forceNoIndex = false,
	ogImage = DEFAULT_OG_IMAGE,
	jsonLd,
	lang = 'es',
	alternates,
} = Astro.props;

const site = await getSiteSettings();
// Studio values can carry trailing spaces or line breaks; search results show them as-is.
const oneLine = (value: string) => value.replace(/\s+/g, ' ').trim();
const title = oneLine(rawTitle);
const description = oneLine(Astro.props.description ?? site.tagline);
const nav = await getNavigation(lang);
const footer = await getFooter(lang);
const favicon = await getFavicon();
const staging = import.meta.env.PUBLIC_SITE_ENV === 'staging';
const PreviewChrome = staging
	? (await import('../components/PreviewChrome.astro')).default
	: null;
const hideFromIndex = forceNoIndex || shouldNoIndex(Astro.url.hostname);
// GTM and Clarity only on the live host, so previews stay out of the stats.
const trackVisits = !staging && !shouldNoIndex(Astro.url.hostname);
const GTM_ID = 'GTM-W3D8LHVV';
const CLARITY_ID = 'ldracdhqpf';
function toAbsolute(value: string) {
	if (value.startsWith('http://') || value.startsWith('https://')) return value;
	const path = value.startsWith('/') ? value : `/${value}`;
	return Astro.site ? new URL(path, Astro.site).href : path;
}
// Prerendered pages report a trailing slash; the sitemap and hreflang use none.
const canonicalPath = Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/+$/, '') : Astro.url.pathname;
const canonicalUrl = canonical
	? toAbsolute(canonical)
	: Astro.site
		? new URL(canonicalPath, Astro.site).href
		: Astro.url.href;
const alternateLinks = [
	alternates?.es ? { hreflang: 'es', href: toAbsolute(alternates.es) } : null,
	alternates?.en ? { hreflang: 'en', href: toAbsolute(alternates.en) } : null,
	alternates?.es ? { hreflang: 'x-default', href: toAbsolute(alternates.es) } : null,
].filter((item): item is { hreflang: string; href: string } => item !== null);
const ogImageUrl = absoluteUrl(ogImage, Astro.site ?? Astro.url);
const rawJsonLd = [
	websiteSchema(),
	organizationSchema(site),
	...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
const jsonLdItems = rawJsonLd.map((item) => {
	if (item && typeof item === 'object') {
		const { '@context': _, ...clean } = item as Record<string, unknown>;
		return clean;
	}
	return item;
});
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		{trackVisits && (
			<script is:inline define:vars={{ GTM_ID, CLARITY_ID }}>
				(function() {
					var loaded = false;
					function loadAnalytics() {
						if (loaded) return;
						loaded = true;
						['scroll', 'touchstart', 'pointerdown', 'keydown'].forEach(function(ev) {
							window.removeEventListener(ev, loadAnalytics, { passive: true });
						});

						(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
						new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
						j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
						'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
						})(window,document,'script','dataLayer',GTM_ID);

						(function(c,l,a,r,i,t,y){
							c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
							t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
							y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
						})(window,document,"clarity","script",CLARITY_ID);
					}

					['scroll', 'touchstart', 'pointerdown', 'keydown'].forEach(function(ev) {
						window.addEventListener(ev, loadAnalytics, { passive: true, once: true });
					});
					window.setTimeout(loadAnalytics, 5000);
				})();
			</script>
		)}
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		{alternateLinks.map((item) => (
			<link rel="alternate" hreflang={item.hreflang} href={item.href} />
		))}
		{hideFromIndex ? (
			<>
				<meta name="robots" content={ROBOTS_NOINDEX} />
				<meta name="googlebot" content={ROBOTS_NOINDEX} />
			</>
		) : (
			<meta name="robots" content="index, follow" />
		)}
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<link
			rel="preload"
			href="/fonts/clash-display/ClashDisplay-Semibold.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/inter/Inter-Variable.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		{favicon ? (
			<link rel="icon" type={favicon.type} href={favicon.href} />
		) : (
			<>
				<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
				<link rel="icon" href="/favicon.ico" />
			</>
		)}
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script
			type="application/ld+json"
			set:html={jsonLdString({
				'@context': 'https://schema.org',
				'@graph': jsonLdItems,
			})}
		/>
		<script is:inline>
			document.documentElement.classList.add('motion-ready');
			window.setTimeout(function () {
				if (!window.__HIWEB_MOTION__) {
					document.documentElement.classList.remove('motion-ready');
				}
			}, 2500);
		</script>
	</head>
	<body id="top">
		{trackVisits && (
			<noscript>
				<iframe
					src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
					height="0"
					width="0"
					style="display:none;visibility:hidden"
				></iframe>
			</noscript>
		)}
		<SiteNav client:load locale={lang} nav={nav} />
		<ScrollIndicator client:load locale={lang} />
		<slot />
		<SiteFooter client:idle locale={lang} footer={footer} site={site} />
		{PreviewChrome && <PreviewChrome />}
		<script src="../scripts/motion.ts"></script>
	</body>
</html>
