---
import type { LpHeroSection } from '../../lib/content/lp-types';
import { Button } from '../ui';
import { LpLeadForm } from './LpLeadForm';
import '../sections/HeroStudioA.css';
import './lp.css';

interface Props {
	section: LpHeroSection;
}

const { section } = Astro.props;
---

<section class="lp-hero">
	<span class="lp-hero__blob top-[-12%] left-[-8%] h-72 w-72 bg-accent-purple/40" aria-hidden="true"></span>
	<span class="lp-hero__blob right-[-6%] bottom-[-18%] h-80 w-80 bg-accent-cyan/25" aria-hidden="true"></span>
	<div class="lp-hero__grid relative z-10 mx-auto grid w-full max-w-[1300px] items-center justify-items-stretch gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-12 lg:px-8">
		<div class="w-full">
			<h1 class="hero-studio-a__title">{section.title}</h1>
			<p class="mt-5 !text-lg !leading-relaxed !text-white/70">{section.description}</p>
			<div class="mt-8 flex flex-wrap items-center gap-3">
				<Button type="button" variant="primary" size="md" data-cal="" client:load>{section.primaryLabel}</Button>
				<Button href={section.whatsappHref} variant="secondary" size="md" className="no-underline" target="_blank" rel="noopener noreferrer" client:load>{section.secondaryLabel}</Button>
			</div>
			{section.trust ? (
				<p class="mt-8 flex items-center gap-3 text-sm text-white/80">
					{section.avatars?.length ? (
						<span class="flex -space-x-2" aria-hidden="true">
							{section.avatars.slice(0, 4).map((avatar) => (
								<img src={avatar.src} alt="" width="36" height="36" class="h-9 w-9 rounded-full border-2 border-[#111] object-cover" />
							))}
						</span>
					) : null}
					{section.trust}
				</p>
			) : null}
		</div>

		<div class="lp-form-card w-full min-w-0 justify-self-stretch p-4 sm:p-5" id="contacto">
			<div class="lp-tabs" aria-label="Forma de contacto">
				<span class="lp-tabs__current">{section.formMessageTab}</span>
				<button type="button" data-cal>{section.formCallTab}</button>
			</div>
			<div class="mt-4">
				<p class="font-sans text-lg font-semibold tracking-tight text-ink">{section.formTitle}</p>
				<p class="mt-1 mb-3 text-sm text-muted">{section.formSubtitle}</p>
				<LpLeadForm
					client:load
					landingName={section.landingName}
					interests={section.interests}
					countries={section.formCountries}
					sizes={section.formSizes}
					budgets={section.formBudgets}
				/>
			</div>
		</div>
	</div>
</section>
