---
import { getCtaBackdrop } from '../../lib/content';
import type { LpSection } from '../../lib/content/lp-types';
import LpHero from './LpHero.astro';
import { CtaBand, LogoMarquee, LpReusable, RoiCalculator, ServiceFocus, ServiceSystem, StatementBlock } from './LpBlocks';

interface Props {
	section: LpSection;
}

const { section } = Astro.props;
const images = section._type === 'finalCta' ? await getCtaBackdrop() : undefined;
---

{section._type === 'lpHero' ? <LpHero section={section} /> : null}
{section._type === 'logoMarquee' ? <LogoMarquee {...section} /> : null}
{section._type === 'roiCalculator' ? <RoiCalculator client:visible {...section} /> : null}
{section._type === 'statement' ? <StatementBlock {...section} /> : null}
{section._type === 'serviceSystem' ? <ServiceSystem client:visible {...section} /> : null}
{section._type === 'lpServiceFocus' ? <ServiceFocus {...section} /> : null}
{section._type === 'ctaBand' ? <CtaBand {...section} /> : null}
{section._type === 'pillarGrid' ||
section._type === 'industryGrid' ||
section._type === 'lpPortal' ||
section._type === 'metricsBand' ||
section._type === 'casePreview' ||
section._type === 'processPhases' ||
section._type === 'teamGrid' ||
section._type === 'faqSection' ||
section._type === 'finalCta' ? (
	<LpReusable client:visible {...section} images={images} />
) : null}
