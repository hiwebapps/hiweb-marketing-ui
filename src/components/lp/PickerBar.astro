---
interface Props {
	prefix: string;
	watching: string;
	changeLabel?: string;
}

const { prefix, watching, changeLabel = 'Cambiar' } = Astro.props;
---

<div class="border-b border-border bg-surface">
	<div class="mx-auto flex max-w-[1300px] flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3 text-sm text-muted sm:px-6 lg:px-8">
		<span>{prefix} <strong class="font-semibold text-ink">{watching}</strong></span>
		<button type="button" class="font-semibold text-ink underline" data-open-picker>{changeLabel}</button>
	</div>
</div>
