---
import { IndustryHero } from './IndustryHero';
import { PillarGrid } from './PillarGrid';
import { ServiceFocus } from './ServiceFocus';
import { ServicePitch } from './ServicePitch';
import { ServiceWhy } from './ServiceWhy';
import { ServicePlans } from './ServicePlans';
import { IndustryGrid } from './IndustryGrid';
import { BeforeAfter } from './BeforeAfter';
import { ProcessPhases } from './ProcessPhases';
import { InstagramGridFeed } from './InstagramGridFeed';
import { CaseStories } from './CaseStories';
import { FaqSection } from './FaqSection';
import FinalCta from './FinalCtaBand.astro';
import { iconForServiceOverviewCard, type PillarIconName } from '../icons/PillarIcons';
import { serviceContentKey } from '../../lib/en-slugs';
import { serviceFocusItems } from '../../data/service-focus';
import type { ServicePitch as Pitch } from '../../data/service-pitch';
import type { IndustryIconName } from '../icons/IndustryIcons';
import type { ServiceIconName } from '../icons/ServiceIcons';
import type { CaseStory } from './CaseStories';
import type { ProcessAccent, ProcessIconName } from './ProcessPhases';
import type { BadgeVariant } from '../ui';
import type { ServiceRecord, ServiceSection, SocialBrandProfile } from '../../lib/content/types';

interface Props {
	section: ServiceSection;
	entry: ServiceRecord;
	pitch?: Pitch;
	industries: { slug: string; nombre: string; tagline: string; puntos: string[] }[];
	phases: { index: string; title: string; description: string }[];
	stories: CaseStory[];
	hasCases: boolean;
	locale?: 'es' | 'en';
	socialBrands?: SocialBrandProfile[];
}

const { section, entry, pitch, industries, phases, stories, hasCases, locale = 'es', socialBrands = [] } = Astro.props;
const contactHref = locale === 'en' ? '/en/contact' : '/contacto';
const contentKey = serviceContentKey(entry.id);
const nombre = entry.data.nombre;
---

{
	section._type === 'serviceHero' && (
		<IndustryHero
			title={section.title || entry.data.heroTitle}
			description={section.description || entry.data.heroDescription || entry.data.tagline}
			image={section.image || entry.data.heroImage || `/images/services/${contentKey}-hero.jpg`}
			imageAlt={section.imageAlt || entry.data.heroImageAlt || `Imagen de ${nombre}`}
			badges={[{ label: section.badge || entry.data.heroBadge || nombre, variant: 'lime' }]}
			ctaLabel={section.ctaLabel || 'Cotiza tu proyecto'}
			ctaHref={section.ctaHref || contactHref}
			headingWidth={section.headingWidth}
		/>
	)
}
{
	section._type === 'serviceOverview' && (
		<PillarGrid
			id="overview"
			eyebrow={section.eyebrow || 'El servicio'}
			title={section.title || `Cómo se entiende ${nombre}`}
			description={section.description || entry.data.tagline}
			pillars={(section.cards?.length ? section.cards : entry.data.cards).map((card, index) => ({
				title: card.title,
				description: card.description,
				icon: iconForServiceOverviewCard(card.title, index),
			}))}
			tone="canvas"
			headingWidth={section.headingWidth}
		/>
	)
}
{
	section._type === 'serviceFocus' && (
		<ServiceFocus
			client:visible
			items={
				section.items?.length
					? section.items.map((item, index) => ({
							id: `${entry.id}-${index}`,
							icon: item.icon as PillarIconName,
							title: item.title,
							summary: item.summary,
							detailTitle: item.detailTitle,
							detail: item.detail,
							image: item.image,
							imageAlt: item.imageAlt,
						}))
					: serviceFocusItems(contentKey)
			}
			eyebrow={section.eyebrow}
			title={section.title}
			description={section.description}
			tone="canvas"
			headingWidth={section.headingWidth}
		/>
	)
}
{
	section._type === 'servicePitch' &&
		(section.title && section.image ? (
			<ServicePitch
				badge={section.badge || nombre}
				title={section.title}
				description={section.description || ''}
				image={section.image}
				imageAlt={section.imageAlt || nombre}
				ctaLabel={section.ctaLabel || 'Agenda un diagnóstico'}
				ctaHref={section.ctaHref || contactHref}
				tone="canvas"
				headingWidth={section.headingWidth}
			/>
		) : pitch ? (
			<ServicePitch {...pitch} tone="canvas" />
		) : null)
}
{
	section._type === 'serviceWhy' && (
		<ServiceWhy
			client:visible
			tone="canvas"
			title={section.title}
			description={section.description}
			ctaLabel={section.ctaLabel}
			ctaHref={section.ctaHref || contactHref}
			cards={section.cards?.map((card) => ({
				title: card.title,
				description: card.description,
				icon: card.icon as ServiceIconName,
				accent: card.accent,
			}))}
			stats={section.stats}
			headingWidth={section.headingWidth}
		/>
	)
}
{
	section._type === 'servicePlans' && section.title && section.plans?.length ? (
		<ServicePlans
			eyebrow={section.eyebrow || (locale === 'en' ? 'Plans' : 'Planes')}
			title={section.title}
			description={section.description || ''}
			note={section.note || ''}
			noteHref={section.noteHref}
			noteLabel={section.noteLabel}
			ctaLabel={section.ctaLabel || 'Cotiza ahora con nosotros'}
			ctaHref={section.ctaHref || contactHref}
			plans={section.plans}
			tone="canvas"
			headingWidth={section.headingWidth}
			includesLabel={locale === 'en' ? 'Includes' : 'Incluye'}
		/>
	) : null
}
{
	section._type === 'serviceIndustries' && (
		<IndustryGrid
			client:visible
			locale={locale}
			hrefPrefix={locale === 'en' ? '/en/industries' : '/industrias'}
			ctaLabel={locale === 'en' ? 'View industry' : 'Ver el sector'}
			eyebrow={locale === 'en' ? 'Industries' : 'Industrias'}
			industries={
				section.items?.length
					? section.items.map((item) => ({
							slug: item.slug,
							nombre: item.nombre,
							tagline: item.tagline,
							puntos: item.puntos,
							icon: item.icon as IndustryIconName | undefined,
						}))
					: industries
			}
			title={section.title || 'Cómo se lee este servicio en cada industria'}
			description={section.description}
			tone="canvas"
			headingWidth={section.headingWidth}
		/>
	)
}
{
	section._type === 'serviceProcess' && (
		<ProcessPhases
			client:visible
			phases={
				section.steps?.length
					? section.steps.map((step, index) => ({
							index: String(index + 1).padStart(2, '0'),
							title: step.title,
							description: step.description,
							icon: step.icon as ProcessIconName | undefined,
							accent: step.accent as ProcessAccent | undefined,
						}))
					: phases
			}
			eyebrow={section.eyebrow || 'Cómo trabajamos'}
			title={section.title || `Proceso de ${nombre}`}
			description={section.description || 'De la auditoría al reporte. Un sistema medible, no un paquete suelto de tácticas.'}
			tone="canvas"
			headingWidth={section.headingWidth}
		/>
	)
}
{
	section._type === 'serviceSocialFeed' && (() => {
		const targetBrands = (section.brands && section.brands.length > 0) ? section.brands : socialBrands;
		return (
			<InstagramGridFeed
				client:visible
				locale={locale}
				eyebrow={section.eyebrow}
				title={section.title}
				description={section.description}
				tone={section.tone || 'canvas'}
				headingWidth={section.headingWidth}
				brands={targetBrands.length > 0 ? targetBrands.map((b) => {
					const indId = b.industryId || (
						b.category?.toLowerCase().includes('restaurante') || b.category?.toLowerCase().includes('pizzer') ? 'restaurantes' :
						b.category?.toLowerCase().includes('retail') || b.category?.toLowerCase().includes('calzado') || b.category?.toLowerCase().includes('moda') || b.category?.toLowerCase().includes('regalo') ? 'retail' :
						b.category?.toLowerCase().includes('turismo') || b.category?.toLowerCase().includes('auto') || b.category?.toLowerCase().includes('fotograf') ? 'turismo' :
						b.category?.toLowerCase().includes('inmobil') || b.category?.toLowerCase().includes('bienes') || b.category?.toLowerCase().includes('terreno') ? 'inmobiliarias' :
						b.category?.toLowerCase().includes('salud') || b.category?.toLowerCase().includes('dental') ? 'salud' :
						'otros'
					);
					const indName = b.industryName || (
						indId === 'restaurantes' ? 'Restaurantes & Gastronomía' :
						indId === 'retail' ? 'Moda & Retail' :
						indId === 'turismo' ? 'Turismo & Destinos' :
						indId === 'inmobiliarias' ? 'Inmobiliarias & Terrenos' :
						indId === 'salud' ? 'Sector Salud' :
						'Otras industrias'
					);
					return {
						id: b.handle || b.id || '',
						name: b.name,
						handle: b.handle,
						category: b.category || '',
						industryId: indId,
						industryName: indName,
						avatar: b.avatar || '',
						bio: b.bio || '',
						linkText: b.linkText,
						linkUrl: b.linkUrl,
						caseSlug: b.caseSlug,
						stats: {
							posts: b.stats?.posts || '0',
							followers: b.stats?.followers || '0',
							following: b.stats?.following || '0',
						},
						highlights: (b.highlights || []).map((h) => ({ title: h.title, cover: h.cover || '' })),
						posts: (b.posts || [])
							.filter((p) => p.showInService !== false)
							.map((p) => ({
								id: p.id,
								brandId: b.handle,
								brandName: b.name,
								brandHandle: b.handle,
								brandAvatar: b.avatar || '',
								brandCategory: b.category || '',
								industryId: indId,
								industryName: indName,
								kind: p.kind,
								cover: p.cover,
								slides: p.slides || [],
								caption: p.caption || '',
								videoUrl: p.videoUrl,
								caseSlug: b.caseSlug || p.caseSlug,
								showInService: p.showInService,
								stats: {
									views: p.stats?.views,
									likes: p.stats?.likes,
									comments: p.stats?.comments,
									shares: p.stats?.shares,
								},
								outcomeTag: p.outcomeTag,
							})),
					};
				}) : undefined}
			/>
		);
	})()
}
{
	section._type === 'serviceCases' && (
		<CaseStories
			client:visible
			locale={locale}
			showAuthor={false}
			eyebrow={section.eyebrow || (locale === 'en' ? 'Case Studies' : 'Casos')}
			title={section.title || (locale === 'en' ? `${nombre} Case Studies` : `Casos de ${nombre}`)}
			description={
				section.description ||
				(hasCases
					? (locale === 'en'
						? 'Results from established companies where this service was a key lever.'
						: 'Resultados de empresas consolidadas donde este servicio fue palanca.')
					: (locale === 'en'
						? 'Documenting more cases for this service. Diagnostic available.'
						: 'Estamos documentando más casos de este servicio. El diagnóstico sigue abierto.'))
			}
			stories={
				section.items?.length
					? section.items.map(
							(item): CaseStory => ({
								client: item.client,
								quote: item.quote,
								name: item.name,
								role: item.role ?? '',
								photo: item.photo,
								cover: item.cover,
								href: item.href,
								stats: item.stats,
							}),
						)
					: stories
			}
			headingWidth={section.headingWidth}
		/>
	)
}
{
	section._type === 'serviceFaq' && (
		<FaqSection
			client:visible
			items={section.items?.length ? section.items : entry.data.faqs}
			eyebrow={section.eyebrow}
			title={section.title}
			withSchema={false}
			columns={section.columns === 1 ? 1 : 2}
			headingWidth={section.headingWidth}
		/>
	)
}
{
	section._type === 'beforeAfter' && section.pairs.length ? (
		<BeforeAfter
			client:visible
			eyebrow={section.eyebrow}
			title={section.title}
			description={section.description}
			badgeVariant={(section.badgeVariant || 'orange') as BadgeVariant}
			headingWidth={section.headingWidth}
			pairs={section.pairs}
		/>
	) : null
}
{
	section._type === 'serviceCta' && (
		<FinalCta
			badge={section.badge || undefined}
			title={section.title ||
				(locale === 'en' ? `Book a ${nombre} diagnostic` : `Agenda un diagnóstico de ${nombre}`)}
			description={section.description || undefined}
			headingWidth={section.headingWidth}
			locale={locale}
		/>
	)
}
