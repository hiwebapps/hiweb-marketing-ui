---
interface Props {
  ctaLabel?: string;
  ctaHref?: string;
  showBadge?: boolean;
}

const {
  ctaLabel = 'Pedir diagnóstico gratis',
  ctaHref = '#diagnostico',
  showBadge = true,
} = Astro.props;
---

<header class="hw-landing-nav fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="max-w-[1300px] mx-auto px-4 sm:px-6 lg:px-8 py-3.5">
    <div class="flex items-center justify-between rounded-full px-5 py-2.5 bg-canvas/85 backdrop-blur-md border border-border shadow-[0_4px_20px_rgba(0,0,0,0.04)]">
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-2.5 group no-underline" aria-label="Hiweb">
        <img
          src="/images/isotipo-hiweb.png"
          width="28"
          height="28"
          alt="Hiweb"
          class="transition-transform duration-200 group-hover:scale-105"
        />
        <span class="font-display font-semibold text-lg tracking-tight text-ink">Hiweb</span>
      </a>

      <!-- Center or Right items -->
      <div class="flex items-center gap-3 sm:gap-4">
        {showBadge && (
          <div class="hidden md:inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface border border-border text-xs font-medium text-ink-soft">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Generación de Leads B2B</span>
          </div>
        )}

        <a
          href={ctaHref}
          class="inline-flex items-center justify-center px-4 sm:px-5 py-2 text-xs sm:text-sm font-semibold rounded-full bg-ink text-canvas hover:bg-ink-soft transition-all duration-150 shadow-sm hover:shadow"
        >
          {ctaLabel}
        </a>
      </div>
    </div>
  </div>
</header>

<div class="h-20" aria-hidden="true"></div>
