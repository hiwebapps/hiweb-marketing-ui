---
interface Props {
	ctaLabel?: string;
	ctaHref?: string;
	/** Button opens the landing calendar (data-cal) instead of following ctaHref. */
	ctaOpensCalendar?: boolean;
	showBadge?: boolean;
	badge?: string;
	whatsappHref?: string;
	whatsappLabel?: string;
}

const {
	ctaLabel = 'Pedir diagnóstico gratis',
	ctaHref = '#diagnostico',
	ctaOpensCalendar = false,
	showBadge = true,
	badge = 'Generación de Leads B2B',
	whatsappHref,
	whatsappLabel = 'WhatsApp',
} = Astro.props;

const ctaClass =
	'inline-flex items-center justify-center px-4 sm:px-5 py-2 text-xs sm:text-sm font-semibold rounded-full bg-ink text-canvas hover:bg-ink-soft transition-all duration-150 shadow-sm hover:shadow no-underline';
---

<header class="hw-landing-nav fixed top-0 left-0 right-0 z-50">
	<div class="max-w-[1300px] mx-auto px-4 sm:px-6 lg:px-8 py-3.5">
		<div class="flex items-center justify-between gap-3 rounded-full px-5 py-2.5 bg-canvas/85 backdrop-blur-md border border-border shadow-[0_4px_20px_rgba(0,0,0,0.04)]">
			<a href="/" class="flex items-center gap-2.5 group no-underline" aria-label="Hiweb">
				<img src="/images/isotipo-hiweb.png" width="28" height="28" alt="" class="h-7 w-7" />
				<span class="font-display font-semibold text-lg tracking-tight text-ink">Hiweb</span>
			</a>

			<div class="flex items-center gap-3 sm:gap-4">
				{showBadge && badge ? (
					<div class="hidden lg:inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface border border-border text-xs font-medium text-ink-soft">
						<span class="w-1.5 h-1.5 rounded-full bg-accent-green"></span>
						<span>{badge}</span>
					</div>
				) : null}
				{whatsappHref ? (
					<a href={whatsappHref} class="hidden sm:inline text-sm font-semibold text-ink no-underline" target="_blank" rel="noopener">
						{whatsappLabel}
					</a>
				) : null}
				{ctaOpensCalendar ? (
					<button type="button" class={ctaClass} data-cal>{ctaLabel}</button>
				) : (
					<a href={ctaHref} class={ctaClass}>{ctaLabel}</a>
				)}
			</div>
		</div>
	</div>
</header>

<div class="h-20" aria-hidden="true"></div>
