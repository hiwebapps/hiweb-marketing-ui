---
import { IndustryHero } from './IndustryHero';
import { AboutHistory } from './AboutHistory';
import { PillarGrid, type Pillar } from './PillarGrid';
import { PresenceMap } from './PresenceMap';
import { PortalShowcase } from './PortalShowcase';
import { BeforeAfter } from './BeforeAfter';
import { TeamGrid, type TeamMember } from './TeamGrid';
import FinalCta from './FinalCtaBand.astro';
import { localePath } from '../../lib/locale';
import type { AboutSection } from '../../lib/content/types';
import type { BadgeVariant } from '../ui';

interface Props {
	section: AboutSection;
	locale?: 'es' | 'en';
	people: TeamMember[];
	heroFallback: string;
	heroAltFallback: string;
}

const {
	section,
	locale = 'es',
	people,
	heroFallback,
	heroAltFallback,
} = Astro.props;

function href(path?: string) {
	const target = path || '/contacto';
	return locale === 'en' ? localePath(target, 'en') : target;
}

const historyColumns =
	section._type === 'aboutHistory' && section.columns && section.columns.length === 2
		? ([section.columns[0], section.columns[1]] as [
				{ title: string; paragraphs: string[] },
				{ title: string; paragraphs: string[] },
			])
		: undefined;

const historyImages = section._type === 'aboutHistory' ? section.images : undefined;

const pillars: Pillar[] =
	section._type === 'aboutPillars'
		? (section.pillars ?? []).map((item) => ({
				title: item.title,
				description: item.description,
				icon: item.icon as Pillar['icon'],
				accent: item.accent as Pillar['accent'],
				href: item.href ? href(item.href) : undefined,
			}))
		: [];

const teamFilters =
	section._type === 'aboutTeam'
		? (section.filters ?? []).flatMap((item) =>
				item.label
					? [
							{
								id: item.id,
								label: item.label,
								members: item.members?.map((person) => ({
									...person,
									accent: person.accent as BadgeVariant | undefined,
								})),
							},
						]
					: [],
			)
		: [];

const portal =
	section._type === 'aboutPortal'
		? section
		: section._type === 'aboutProcess'
			? section
			: null;
---

{
	section._type === 'aboutHero' && (
		<IndustryHero
			title={section.title || ''}
			description={section.description || ''}
			image={section.image || heroFallback}
			imageAlt={section.imageAlt || heroAltFallback}
			imagePosition={section.imagePosition || 'center 28%'}
			badges={(section.badges ?? []).map((badge) => ({
				label: badge.label,
				variant: (badge.variant || 'lime') as BadgeVariant,
			}))}
			ctaLabel={section.ctaLabel}
			ctaHref={href(section.ctaHref)}
			headingWidth={section.headingWidth}
		/>
	)
}
{
	section._type === 'aboutHistory' && (
		<AboutHistory
			eyebrow={section.eyebrow}
			title={section.title}
			description={section.description}
			images={historyImages}
			columns={historyColumns}
			headingWidth={section.headingWidth}
		/>
	)
}
{
	section._type === 'aboutPillars' && (
		<PillarGrid
			eyebrow={section.eyebrow}
			title={section.title}
			description={section.description}
			pillars={pillars}
			headingWidth={section.headingWidth}
		/>
	)
}
{
	portal && (
		<PortalShowcase
			locale={locale}
			eyebrow={portal.eyebrow}
			title={portal.title}
			description={portal.description}
			badgeVariant={((section._type === 'aboutPortal' && section.badgeVariant) || 'cyan') as BadgeVariant}
			headingWidth={portal.headingWidth}
			clientName={section._type === 'aboutPortal' ? section.clientName : undefined}
			primaryLabel={section._type === 'aboutPortal' ? section.primaryLabel : undefined}
			primaryHref={
				section._type === 'aboutPortal' && section.primaryHref
					? section.primaryHref
					: locale === 'en'
						? '/en/portal'
						: '/portal'
			}
			secondaryLabel={section._type === 'aboutPortal' ? section.secondaryLabel : undefined}
			secondaryHref={
				section._type === 'aboutPortal' && section.secondaryHref ? section.secondaryHref : '/contacto'
			}
		/>
	)
}
{
	section._type === 'beforeAfter' && section.pairs?.length ? (
		<BeforeAfter
			client:visible
			eyebrow={section.eyebrow}
			title={section.title}
			description={section.description}
			badgeVariant={(section.badgeVariant || 'orange') as BadgeVariant}
			headingWidth={section.headingWidth}
			pairs={section.pairs}
		/>
	) : null
}
{
	section._type === 'aboutTeam' && (
		<TeamGrid
			client:load
			slider
			showFilters
			previousLabel={locale === 'en' ? 'Previous teammate' : 'Integrante anterior'}
			nextLabel={locale === 'en' ? 'Next teammate' : 'Siguiente integrante'}
			positionLabel={locale === 'en' ? 'Go to slide' : 'Ir a la posición'}
			members={people}
			eyebrow={section.eyebrow}
			title={section.title}
			description={section.description}
			ctaLabel={section.ctaLabel}
			ctaHref={href(section.ctaHref)}
			filters={teamFilters.length ? teamFilters : undefined}
			filterLabel={section.filterLabel}
			headingWidth={section.headingWidth}
		/>
	)
}
{
	section._type === 'aboutMap' && (
		<PresenceMap
			client:visible
			eyebrow={section.eyebrow}
			title={section.title}
			description={section.description}
			sectionLabel={section.sectionLabel}
			globeLabel={section.globeLabel}
			ctaLabel={section.ctaLabel}
			ctaHref={section.ctaHref}
			headingWidth={section.headingWidth}
		/>
	)
}
{
	section._type === 'aboutCta' && (
		<FinalCta
			badge={section.badge}
			title={section.title}
			description={section.description}
			primaryLabel={section.ctaLabel}
			primaryHref={href(section.ctaHref)}
			headingWidth={section.headingWidth}
		/>
	)
}
