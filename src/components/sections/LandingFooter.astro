---
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface text-ink-soft py-10 px-4 sm:px-6 lg:px-8 mt-16">
  <div class="max-w-[1300px] mx-auto flex flex-col md:flex-row items-center justify-between gap-6 text-sm">
    <div class="flex items-center gap-3">
      <img src="/images/isotipo-hiweb.png" width="22" height="22" alt="Hiweb" class="opacity-80" />
      <p class="text-xs sm:text-sm text-muted">
        © {year} Hiweb. Partner estratégico en crecimiento digital B2B.
      </p>
    </div>

    <nav aria-label="Enlaces legales" class="flex flex-wrap items-center justify-center gap-6 text-xs sm:text-sm text-muted">
      <a href="/aviso-de-privacidad" class="hover:text-ink transition-colors underline-offset-4 hover:underline">
        Aviso de Privacidad
      </a>
      <a href="/terminos" class="hover:text-ink transition-colors underline-offset-4 hover:underline">
        Términos y Condiciones
      </a>
      <a href="/contacto" class="hover:text-ink transition-colors underline-offset-4 hover:underline">
        Contacto
      </a>
    </nav>
  </div>
</footer>
