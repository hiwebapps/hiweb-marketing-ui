---
interface BlockSpan {
  text?: string;
}

interface Block {
  children?: BlockSpan[];
}

interface CellObject {
  value?: Block[] | null;
}

interface Props {
  node: {
    _type?: string;
    caption?: string | null;
    hasHeaderRow?: boolean | null;
    headerRows?: number | null;
    rows?: Array<{
      cells?: Array<string | CellObject | null> | null;
    } | null> | null;
  };
}

function cellToPlain(cell: string | CellObject | null | undefined): string {
  if (cell == null) return '';
  if (typeof cell === 'string') return cell;
  const blocks = cell.value ?? [];
  return blocks
    .flatMap((block) => block.children ?? [])
    .map((span) => span.text ?? '')
    .join('')
    .trim();
}

const { node } = Astro.props;
const rows = (node.rows ?? [])
  .map((row) => (row?.cells ?? []).map((cell) => cellToPlain(cell)))
  .filter((cells) => cells.some(Boolean) || cells.length > 0);

if (!rows.length) {
  return null;
}

const hasHeader =
  typeof node.headerRows === 'number' ? node.headerRows > 0 : node.hasHeaderRow !== false;

const header = hasHeader ? rows[0] : null;
const body = hasHeader ? rows.slice(1) : rows;
const headerLabels = header ?? [];

// On phones a short table stays a table; anything wider becomes a list by row.
const columns = Math.max(...rows.map((cells) => cells.length));
const longest = Math.max(0, ...body.flat().map((cell) => cell.length));
const fits = (columns <= 2 && longest <= 90) || (columns === 3 && longest <= 45);

// A short column with repeated values (a phase, a level) reads as a tag.
const tagColumns = new Set(
  Array.from({ length: columns }, (_, i) => i).filter((i) => {
    if (i === 0 || body.length < 3) return false;
    const values = body.map((cells) => cells[i] ?? '').filter(Boolean);
    return values.every((value) => value.length <= 20) && new Set(values).size <= values.length / 2;
  }),
);
---

<figure class:list={["blog-table-wrap", fits ? "is-fit" : "is-list"]}>
  {node.caption ? <figcaption class="blog-table__caption">{node.caption}</figcaption> : null}
  <table class="blog-table">
    {
      header ? (
        <thead>
          <tr>
            {header.map((cell) => (
              <th scope="col">{cell}</th>
            ))}
          </tr>
        </thead>
      ) : null
    }
    <tbody>
      {
        body.map((cells) => (
          <tr>
            {cells.map((cell, i) => (
              <td data-label={headerLabels[i] || undefined}>
                {tagColumns.has(i) && cell ? <span class="blog-table__tag">{cell}</span> : cell}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</figure>
