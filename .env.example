# Sanity (public — used by Astro front)
PUBLIC_SANITY_PROJECT_ID=fxardjr1
PUBLIC_SANITY_DATASET=web-2026
SANITY_STUDIO_PROJECT_ID=fxardjr1
SANITY_STUDIO_DATASET=web-2026

# Canonical / OG. Worker is the public host (still noindex until cutover).
PUBLIC_SITE_URL=https://hiweb-marketing-ui.hiwebapps.workers.dev

# Search indexing — keep false/unset until cutover (see docs/cms/CUTOVER-SEO.md).
# Indexing requires this flag AND the live hostname www.hiwebmarketing.com.
PUBLIC_SITE_INDEXABLE=false

# Viewer token for published fetches / TypeGen (server-only)
# https://www.sanity.io/manage → API → Tokens
SANITY_API_READ_TOKEN=

# Editor/Admin token for scripts/sanity/seed-from-collections.ts
SANITY_API_WRITE_TOKEN=

# Preview origin if Presentation is added later (not in this track)
SANITY_STUDIO_PREVIEW_URL=http://localhost:4321

# Sanity → POST /api/sanity-webhook (Authorization: Bearer <secret>)
SANITY_REVALIDATE_SECRET=

# Cloudflare Workers deploy hook (rebuild prerendered pages after publish)
CLOUDFLARE_DEPLOY_HOOK_URL=

# Fallback Worker-only rebuild via GitHub Actions (repository_dispatch sanity-rebuild)
GITHUB_DISPATCH_TOKEN=
GITHUB_DISPATCH_REPO=hiwebapps/hiweb-marketing-ui
