{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hiweb-marketing-ui",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker.ts",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "vars": {
    "PUBLIC_SITE_INDEXABLE": "true",
    "PUBLIC_SITE_URL": "https://www.hiwebmarketing.com",
    "PUBLIC_SANITY_PROJECT_ID": "fxardjr1",
    "PUBLIC_SANITY_DATASET": "web-2026"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "hiweb-marketing-quiz-calendar",
      "database_id": "282c179c-d35d-4dfa-b631-afaad98d802c",
      "migrations_dir": "migrations/d1"
    }
  ],
  // Per-IP limits for the public booking and quiz APIs (src/lib/growth/api/rate-limit.ts).
  "ratelimits": [
    { "name": "FORM_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "API_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "env": {
    "staging": {
      "name": "hiweb-marketing-ui-staging",
      "vars": {
        "PUBLIC_SITE_ENV": "staging",
        "PUBLIC_SITE_INDEXABLE": "false",
        "PUBLIC_SITE_URL": "https://staging.hiweb.com.mx",
        "PUBLIC_SANITY_PROJECT_ID": "fxardjr1",
        "PUBLIC_SANITY_DATASET": "web-2026"
      },
      "d1_databases": [
        {
          "binding": "DATABASE",
          "database_name": "hiweb-marketing-quiz-calendar-staging",
          "database_id": "0391782c-b084-452c-a283-74af9c54451f",
          "migrations_dir": "migrations/d1"
        }
      ],
      "ratelimits": [
        { "name": "FORM_RATE_LIMITER", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } },
        { "name": "API_RATE_LIMITER", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } }
      ],
      "triggers": {
        "crons": []
      }
    }
  }
}
